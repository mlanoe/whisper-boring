# src/encoder.br — Whisper audio encoder (float32, GPU-resident)
#
# Architecture (for "base" model, d=512, n_head=8, n_layer=6):
#   Conv1d(80 → 512, k=3, GELU)
#   Conv1d(512 → 512, k=3, stride=2, GELU)
#   + learned positional embedding (1500 × 512)
#   6 × TransformerBlock (pre-norm, self-attention, MLP with GELU)
#   LayerNorm(512)

use audio
use math
use math_gpu

pub struct EncoderBlock:
    # Self-attention (weights uploaded once to GPU at load time)
    [float32]'kernel'unified attn_q_w
    [float32]'kernel'unified attn_q_b
    [float32]'kernel'unified attn_k_w   # no bias on K in Whisper encoder
    [float32]'kernel'unified attn_v_w
    [float32]'kernel'unified attn_v_b
    [float32]'kernel'unified attn_o_w
    [float32]'kernel'unified attn_o_b
    # Layer norms
    [float32]'kernel'unified ln1_w
    [float32]'kernel'unified ln1_b
    [float32]'kernel'unified ln2_w
    [float32]'kernel'unified ln2_b
    # MLP: d → 4d → d with GELU
    [float32]'kernel'unified mlp_fc_w
    [float32]'kernel'unified mlp_fc_b
    [float32]'kernel'unified mlp_pr_w
    [float32]'kernel'unified mlp_pr_b

    req [float32] forward([float32] x, int seq, int d, int n_head) throws:
        encoder_block_forward_gpu(self, x, seq, d, n_head)

# GPU-resident forward for one EncoderBlock: keeps the residual stream on the
# device across blocks without any CPU readback between layers.
pub req [float32]'kernel'unified encoder_block_forward_gpu(
        EncoderBlock b, [float32]'kernel'global x, int seq, int d, int n_head) throws:
    # Pre-norm self-attention + residual
    let [float32]'kernel'unified h1 = layer_norm_seq_gpu(x, b.ln1_w, b.ln1_b, seq, d)
    let [float32]'kernel'unified sa = mha_nobias_k_gpu(h1, h1,
        b.attn_q_w, b.attn_q_b,
        b.attn_k_w,
        b.attn_v_w, b.attn_v_b,
        b.attn_o_w, b.attn_o_b,
        seq, seq, d, n_head, false)
    let [float32]'kernel'unified r1 = add_gpu(x, sa, seq * d)

    # Pre-norm MLP + residual
    let [float32]'kernel'unified h2  = layer_norm_seq_gpu(r1, b.ln2_w, b.ln2_b, seq, d)
    let [float32]'kernel'unified fc  = linear_gpu(h2, b.mlp_fc_w, b.mlp_fc_b, seq, d, d * 4)
    let [float32]'kernel'unified act = gelu_gpu(fc)
    let [float32]'kernel'unified pr  = linear_gpu(act, b.mlp_pr_w, b.mlp_pr_b, seq, d * 4, d)
    add_gpu(r1, pr, seq * d)

pub struct AudioEncoder:
    # Convolutional stem
    [float32]'kernel'unified conv1_w   # (d, 80, 3)
    [float32]'kernel'unified conv1_b
    [float32]'kernel'unified conv2_w   # (d, d, 3)
    [float32]'kernel'unified conv2_b
    # Positional embedding: (1500, d)
    [float32]'kernel'unified pos_emb
    # Transformer blocks
    [EncoderBlock] blocks
    # Final layer norm
    [float32]'kernel'unified ln_w
    [float32]'kernel'unified ln_b
    # Model dimensions
    int n_head_val

    req int d():      self.ln_w.length
    req int n_head(): self.n_head_val

    req [float32] forward(MelSpectrogram mel) throws:
        encoder_forward_gpu(self, mel)

pub req [float32]'kernel'unified encoder_forward_gpu(AudioEncoder enc, MelSpectrogram mel) throws:
    let int d      = enc.d()
    let int n_head = enc.n_head()
    let int t_in   = mel.n_frames

    # Conv stem: mel.data is (N_MELS × N_FRAMES), transpose on GPU to (N_FRAMES × N_MELS)
    let [float32]'kernel'unified x = transpose_gpu(mel.data, mel.n_mels, t_in)

    # Conv1(80 → d, k=3, stride=1) + GELU
    let [float32]'kernel'unified c1 = conv1d_gpu(x, enc.conv1_w, enc.conv1_b, t_in, mel.n_mels, d, 3, 1, t_in)
    let [float32]'kernel'unified a1 = gelu_gpu(c1)

    # Conv2(d → d, k=3, stride=2) + GELU — halves sequence length to 1500
    let int t_out = t_in / 2
    let [float32]'kernel'unified c2 = conv1d_gpu(a1, enc.conv2_w, enc.conv2_b, t_in, d, d, 3, 2, t_out)
    let [float32]'kernel'unified a2 = gelu_gpu(c2)

    # Add positional embedding on GPU
    guard t_out * d == enc.pos_emb.length else throw "encoder: positional embedding size mismatch"
    var [float32]'kernel'unified h = add_gpu(a2, enc.pos_emb, t_out * d)

    # Transformer blocks (100% GPU-resident across all layers)
    for block in enc.blocks:
        h = encoder_block_forward_gpu(block, h, t_out, d, n_head)

    # Final layer norm
    layer_norm_seq_gpu(h, enc.ln_w, enc.ln_b, t_out, d)
