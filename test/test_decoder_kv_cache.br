# test/test_decoder_kv_cache.br — verifies that TextDecoder.forward_step_all
# (the KV-cache path) produces, at every position, the same logits as
# reprocessing the whole sequence from scratch with TextDecoder.forward.
use io
use math
use math_gpu
use tokenizer
use decoder

let int D       = 8
let int N_HEAD  = 2
let int N_VOCAB = 15

pub req [float32] mk(int n, float32 scale, float32 bias):
    mut [float32] out = []
    for i in 0..<n:
        out.push((((i * 37 + 11) % 97) as float32 / 97.0) * scale - bias)
    out

pub req DecoderBlock mk_block() throws:
    DecoderBlock(
        sa_q_w = upload_floats_gpu(mk(D * D, 0.2, 0.1)),  sa_q_b = upload_floats_gpu(mk(D, 0.1, 0.05)),
        sa_k_w = upload_floats_gpu(mk(D * D, 0.2, 0.1)),
        sa_v_w = upload_floats_gpu(mk(D * D, 0.2, 0.1)),  sa_v_b = upload_floats_gpu(mk(D, 0.1, 0.05)),
        sa_o_w = upload_floats_gpu(mk(D * D, 0.2, 0.1)),  sa_o_b = upload_floats_gpu(mk(D, 0.1, 0.05)),
        ln1_w  = upload_floats_gpu(mk(D, 0.05, -1.0)),    ln1_b  = upload_floats_gpu(mk(D, 0.05, 0.0)),
        ca_q_w = upload_floats_gpu(mk(D * D, 0.2, 0.1)),  ca_q_b = upload_floats_gpu(mk(D, 0.1, 0.05)),
        ca_k_w = upload_floats_gpu(mk(D * D, 0.2, 0.1)),
        ca_v_w = upload_floats_gpu(mk(D * D, 0.2, 0.1)),  ca_v_b = upload_floats_gpu(mk(D, 0.1, 0.05)),
        ca_o_w = upload_floats_gpu(mk(D * D, 0.2, 0.1)),  ca_o_b = upload_floats_gpu(mk(D, 0.1, 0.05)),
        ln2_w  = upload_floats_gpu(mk(D, 0.05, -1.0)),    ln2_b  = upload_floats_gpu(mk(D, 0.05, 0.0)),
        mlp_fc_w = upload_floats_gpu(mk(D * 4 * D, 0.1, 0.05)), mlp_fc_b = upload_floats_gpu(mk(D * 4, 0.05, 0.02)),
        mlp_pr_w = upload_floats_gpu(mk(D * D * 4, 0.1, 0.05)), mlp_pr_b = upload_floats_gpu(mk(D, 0.05, 0.02)),
        ln3_w  = upload_floats_gpu(mk(D, 0.05, -1.0)),    ln3_b  = upload_floats_gpu(mk(D, 0.05, 0.0)),
        cache_sa_k = [], cache_sa_v = [],
        cache_ca_k = [], cache_ca_v = [],
        ca_cached  = false
    )

def main() throws:
    print "=== decoder KV-cache correctness ==="

    let int seq_a = 5
    let [int] seq_tokens = [3, 7, 1, 9, 4, 2]

    let TextDecoder dec_ref = TextDecoder(
        tok_emb = upload_floats_gpu(mk(N_VOCAB * D, 0.3, 0.15)),
        pos_emb = upload_floats_gpu(mk(448 * D, 0.2, 0.1)),
        blocks = [mk_block(), mk_block()],
        ln_w = upload_floats_gpu(mk(D, 0.05, -1.0)), ln_b = upload_floats_gpu(mk(D, 0.05, 0.0)), n_head_val = N_HEAD)
    mut TextDecoder dec_kv = TextDecoder(
        tok_emb = upload_floats_gpu(mk(N_VOCAB * D, 0.3, 0.15)),
        pos_emb = upload_floats_gpu(mk(448 * D, 0.2, 0.1)),
        blocks = [mk_block(), mk_block()],
        ln_w = upload_floats_gpu(mk(D, 0.05, -1.0)), ln_b = upload_floats_gpu(mk(D, 0.05, 0.0)), n_head_val = N_HEAD)

    let [float32] audio = mk(seq_a * D, 0.4, 0.2)

    var float32 max_diff = 0.0
    mut [int] tokens_so_far = []
    var int pos = 0
    while pos < seq_tokens.length:
        tokens_so_far.push(seq_tokens[pos])

        let [float32] logits_ref = dec_ref.forward(tokens_so_far, audio, seq_a)
        let [float32] logits_kv  = dec_kv.forward_step_all(seq_tokens[pos], pos, audio, seq_a)

        guard logits_ref.length == logits_kv.length else throw "logits length mismatch at pos {pos}"
        var int v = 0
        while v < logits_ref.length:
            let dd = if logits_ref[v] > logits_kv[v]: logits_ref[v] - logits_kv[v] else: logits_kv[v] - logits_ref[v]
            if dd > max_diff: max_diff = dd
            v += 1

        print "pos {pos}: max |ref-kv| so far = {max_diff:.8f}"
        pos += 1

    print "final max diff = {max_diff:.8f}  (expect ~0)"
    guard max_diff < 1e-5 else throw "KV-cache path diverged from reference (max diff {max_diff})"

    # Verify batched prompt prefill + incremental step matches reference argmax
    mut TextDecoder dec_prefill = TextDecoder(
        tok_emb = upload_floats_gpu(mk(N_VOCAB * D, 0.3, 0.15)),
        pos_emb = upload_floats_gpu(mk(448 * D, 0.2, 0.1)),
        blocks = [mk_block(), mk_block()],
        ln_w = upload_floats_gpu(mk(D, 0.05, -1.0)), ln_b = upload_floats_gpu(mk(D, 0.05, 0.0)), n_head_val = N_HEAD)
    let [int] prompt = [seq_tokens[0], seq_tokens[1], seq_tokens[2], seq_tokens[3]]
    let [float32] logits_prompt_ref = dec_ref.forward(prompt, audio, seq_a)
    var int best_ref = 0
    for i in 1..<logits_prompt_ref.length:
        if logits_prompt_ref[i] > logits_prompt_ref[best_ref]:
            best_ref = i
    let int best_prefill = dec_prefill.prefill_prompt_token_gpu(prompt, audio, seq_a)
    guard best_prefill == best_ref else throw "prefill_prompt_token_gpu mismatch: got {best_prefill}, expected {best_ref}"

    let [int] prompt_plus = [seq_tokens[0], seq_tokens[1], seq_tokens[2], seq_tokens[3], best_ref]
    let [float32] logits_step_ref = dec_ref.forward(prompt_plus, audio, seq_a)
    var int best_step_ref = 0
    for i in 1..<logits_step_ref.length:
        if logits_step_ref[i] > logits_step_ref[best_step_ref]:
            best_step_ref = i
    let int best_step_kv = dec_prefill.forward_step_token_gpu(best_ref, 4, audio, seq_a)
    guard best_step_kv == best_step_ref else throw "forward_step_token_gpu after prefill mismatch: got {best_step_kv}, expected {best_step_ref}"
    print "batched prompt prefill + step argmax verified!"

    print "=== decoder KV-cache test passed ==="
