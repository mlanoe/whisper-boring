# src/decoder.br — Whisper text decoder (float32, GPU-resident weights & KV-cache)
#
# Architecture (for "base" model, d=512, n_head=8, n_layer=6):
#   token embedding (51865 × 512) + positional embedding (448 × 512)
#   6 × DecoderBlock (causal self-attn, cross-attn, MLP)
#   LayerNorm(512)
#   Linear → logits (512 → 51865), weight-tied with token embedding

use math
use math_gpu
use tokenizer

pub struct DecoderBlock:
    # Causal self-attention
    [float32]'kernel'unified sa_q_w
    [float32]'kernel'unified sa_q_b
    [float32]'kernel'unified sa_k_w
    [float32]'kernel'unified sa_v_w
    [float32]'kernel'unified sa_v_b
    [float32]'kernel'unified sa_o_w
    [float32]'kernel'unified sa_o_b
    [float32]'kernel'unified ln1_w
    [float32]'kernel'unified ln1_b
    # Cross-attention (keys/values come from the audio encoder)
    [float32]'kernel'unified ca_q_w
    [float32]'kernel'unified ca_q_b
    [float32]'kernel'unified ca_k_w
    [float32]'kernel'unified ca_v_w
    [float32]'kernel'unified ca_v_b
    [float32]'kernel'unified ca_o_w
    [float32]'kernel'unified ca_o_b
    [float32]'kernel'unified ln2_w
    [float32]'kernel'unified ln2_b
    # MLP: d → 4d → d with GELU
    [float32]'kernel'unified mlp_fc_w
    [float32]'kernel'unified mlp_fc_b
    [float32]'kernel'unified mlp_pr_w
    [float32]'kernel'unified mlp_pr_b
    [float32]'kernel'unified ln3_w
    [float32]'kernel'unified ln3_b

    # GPU-resident incremental KV-cache state
    var [float32]'kernel'unified cache_sa_k = []
    var [float32]'kernel'unified cache_sa_v = []
    var [float32]'kernel'unified cache_ca_k = []
    var [float32]'kernel'unified cache_ca_v = []
    var bool                     ca_cached  = false

    # Full-sequence forward pass (x: seq_t × d, audio: seq_a × d)
    req [float32] forward([float32] x, [float32] audio,
                          int seq_t, int seq_a, int d, int n_head) throws:
        decoder_block_forward_gpu(self, x, audio, seq_t, seq_a, d, n_head)

# GPU-resident full-sequence forward for one DecoderBlock.
pub req [float32]'kernel'unified decoder_block_forward_gpu(
        DecoderBlock b, [float32]'kernel'global x, [float32]'kernel'global audio,
        int seq_t, int seq_a, int d, int n_head) throws:
    # Causal self-attention + residual
    let [float32]'kernel'unified h1 = layer_norm_seq_gpu(x, b.ln1_w, b.ln1_b, seq_t, d)
    let [float32]'kernel'unified sa = mha_nobias_k_gpu(h1, h1,
        b.sa_q_w, b.sa_q_b,
        b.sa_k_w,
        b.sa_v_w, b.sa_v_b,
        b.sa_o_w, b.sa_o_b,
        seq_t, seq_t, d, n_head, true)
    let [float32]'kernel'unified r1 = add_gpu(x, sa, seq_t * d)

    # Cross-attention + residual
    let [float32]'kernel'unified h2 = layer_norm_seq_gpu(r1, b.ln2_w, b.ln2_b, seq_t, d)
    let [float32]'kernel'unified ca = mha_nobias_k_gpu(h2, audio,
        b.ca_q_w, b.ca_q_b,
        b.ca_k_w,
        b.ca_v_w, b.ca_v_b,
        b.ca_o_w, b.ca_o_b,
        seq_t, seq_a, d, n_head, false)
    let [float32]'kernel'unified r2 = add_gpu(r1, ca, seq_t * d)

    # MLP + residual
    let [float32]'kernel'unified h3  = layer_norm_seq_gpu(r2, b.ln3_w, b.ln3_b, seq_t, d)
    let [float32]'kernel'unified fc  = linear_gpu(h3, b.mlp_fc_w, b.mlp_fc_b, seq_t, d, d * 4)
    let [float32]'kernel'unified act = gelu_gpu(fc)
    let [float32]'kernel'unified pr  = linear_gpu(act, b.mlp_pr_w, b.mlp_pr_b, seq_t, d * 4, d)
    add_gpu(r2, pr, seq_t * d)

# Precompute cross-attention K/V once on the first decode step; no-op thereafter.
pub req DecoderBlock ensure_cross_kv_gpu(
        DecoderBlock b, [float32]'kernel'global audio, int seq_a, int d) throws:
    if b.ca_cached:
        return b
    let [float32]'kernel'unified ca_k = linear_nobias_gpu(audio, b.ca_k_w, seq_a, d, d)
    let [float32]'kernel'unified ca_v = linear_gpu(audio, b.ca_v_w, b.ca_v_b, seq_a, d, d)
    DecoderBlock(
        sa_q_w     = b.sa_q_w,
        sa_q_b     = b.sa_q_b,
        sa_k_w     = b.sa_k_w,
        sa_v_w     = b.sa_v_w,
        sa_v_b     = b.sa_v_b,
        sa_o_w     = b.sa_o_w,
        sa_o_b     = b.sa_o_b,
        ln1_w      = b.ln1_w,
        ln1_b      = b.ln1_b,
        ca_q_w     = b.ca_q_w,
        ca_q_b     = b.ca_q_b,
        ca_k_w     = b.ca_k_w,
        ca_v_w     = b.ca_v_w,
        ca_v_b     = b.ca_v_b,
        ca_o_w     = b.ca_o_w,
        ca_o_b     = b.ca_o_b,
        ln2_w      = b.ln2_w,
        ln2_b      = b.ln2_b,
        mlp_fc_w   = b.mlp_fc_w,
        mlp_fc_b   = b.mlp_fc_b,
        mlp_pr_w   = b.mlp_pr_w,
        mlp_pr_b   = b.mlp_pr_b,
        ln3_w      = b.ln3_w,
        ln3_b      = b.ln3_b,
        cache_sa_k = b.cache_sa_k,
        cache_sa_v = b.cache_sa_v,
        cache_ca_k = ca_k,
        cache_ca_v = ca_v,
        ca_cached  = true
    )

# GPU-resident incremental (KV-cache) forward for ONE new token.
# Returns (updated GPU-resident x_new, updated DecoderBlock with grown GPU KV-cache).
pub req ([float32]'kernel'unified, DecoderBlock) decoder_block_step_gpu(
        DecoderBlock b0, [float32]'kernel'global x_new, [float32]'kernel'global audio,
        int seq_a, int d, int n_head) throws:
    let DecoderBlock b = ensure_cross_kv_gpu(b0, audio, seq_a, d)

    # Causal self-attention + fused residual + ln2
    let [float32]'kernel'unified h1 = layer_norm_seq_gpu(x_new, b.ln1_w, b.ln1_b, 1, d)
    let ([float32]'kernel'unified sa, [float32]'kernel'unified new_sa_k, [float32]'kernel'unified new_sa_v) = mha_step_nobias_k_gpu(
        h1,
        b.sa_q_w, b.sa_q_b,
        b.sa_k_w,
        b.sa_v_w, b.sa_v_b,
        b.sa_o_w, b.sa_o_b,
        b.cache_sa_k, b.cache_sa_v,
        d, n_head)
    let ([float32]'kernel'unified r1, [float32]'kernel'unified h2) = add_layer_norm_decode_gpu(
        x_new, sa, b.ln2_w, b.ln2_b, d)

    # Cross-attention + fused residual + ln3
    let [float32]'kernel'unified ca = mha_cross_step_gpu(h2,
        b.ca_q_w, b.ca_q_b,
        b.cache_ca_k, b.cache_ca_v,
        b.ca_o_w, b.ca_o_b,
        seq_a, d, n_head)
    let ([float32]'kernel'unified r2, [float32]'kernel'unified h3) = add_layer_norm_decode_gpu(
        r1, ca, b.ln3_w, b.ln3_b, d)

    # MLP + residual
    let [float32]'kernel'unified fc  = linear_gpu(h3, b.mlp_fc_w, b.mlp_fc_b, 1, d, d * 4)
    let [float32]'kernel'unified act = gelu_gpu(fc)
    let [float32]'kernel'unified pr  = linear_gpu(act, b.mlp_pr_w, b.mlp_pr_b, 1, d * 4, d)
    let [float32]'kernel'unified out = add_gpu(r2, pr, d)

    let DecoderBlock next_b = DecoderBlock(
        sa_q_w     = b.sa_q_w,
        sa_q_b     = b.sa_q_b,
        sa_k_w     = b.sa_k_w,
        sa_v_w     = b.sa_v_w,
        sa_v_b     = b.sa_v_b,
        sa_o_w     = b.sa_o_w,
        sa_o_b     = b.sa_o_b,
        ln1_w      = b.ln1_w,
        ln1_b      = b.ln1_b,
        ca_q_w     = b.ca_q_w,
        ca_q_b     = b.ca_q_b,
        ca_k_w     = b.ca_k_w,
        ca_v_w     = b.ca_v_w,
        ca_v_b     = b.ca_v_b,
        ca_o_w     = b.ca_o_w,
        ca_o_b     = b.ca_o_b,
        ln2_w      = b.ln2_w,
        ln2_b      = b.ln2_b,
        mlp_fc_w   = b.mlp_fc_w,
        mlp_fc_b   = b.mlp_fc_b,
        mlp_pr_w   = b.mlp_pr_w,
        mlp_pr_b   = b.mlp_pr_b,
        ln3_w      = b.ln3_w,
        ln3_b      = b.ln3_b,
        cache_sa_k = new_sa_k,
        cache_sa_v = new_sa_v,
        cache_ca_k = b.cache_ca_k,
        cache_ca_v = b.cache_ca_v,
        ca_cached  = true
    )
    (out, next_b)

pub struct TextDecoder:
    [float32]'kernel'unified tok_emb   # (n_vocab × d) — used for both token lookup and weight-tied LM head
    [float32]'kernel'unified pos_emb   # (max_ctx × d)
    var [DecoderBlock]       blocks
    [float32]'kernel'unified ln_w
    [float32]'kernel'unified ln_b
    int                      n_head_val

    req int d():       self.ln_w.length
    req int n_vocab(): self.tok_emb.length / self.d()
    req int n_head():  self.n_head_val

    # Run the decoder for the given token sequence, return logits for the last position.
    req [float32] forward([int] tokens, [float32] audio, int seq_a) throws:
        let int d       = self.d()
        let int n_head  = self.n_head()
        let int n_vocab = self.n_vocab()
        let int seq_t   = tokens.length

        guard seq_t <= 448 else throw "decoder: sequence exceeds maximum context (448)"

        # Build (seq_t × d) token + positional embeddings on GPU (fused single launch)
        var [float32]'kernel'unified x = embed_tokens_sequence_gpu(self.tok_emb, self.pos_emb, tokens, seq_t, d)

        let [float32]'kernel'unified audio_gpu = upload_floats_gpu(audio)

        # Transformer blocks (100% GPU-resident across all layers)
        for block in self.blocks:
            x = decoder_block_forward_gpu(block, x, audio_gpu, seq_t, seq_a, d, n_head)

        # Layer norm on last position only, then weight-tied vocab projection (no bias)
        let [float32]'kernel'unified last   = slice_row_gpu(x, seq_t - 1, d)
        let [float32]'kernel'unified normed = layer_norm_seq_gpu(last, self.ln_w, self.ln_b, 1, d)
        linear_nobias_gpu(normed, self.tok_emb, 1, d, n_vocab)

    # Incremental forward for ONE new token at position `pos` (KV-cache).
    def [float32] forward_step_all(int token_id, int pos, [float32] audio, int seq_a) throws:
        let int d       = self.d()
        let int n_head  = self.n_head()
        let int n_vocab = self.n_vocab()

        guard pos < 448 else throw "decoder: sequence exceeds maximum context (448)"

        var [float32]'kernel'unified x_new = embed_token_step_gpu(self.tok_emb, self.pos_emb, token_id, pos, d)

        mut [DecoderBlock] next_blocks = []
        for i in 0..<self.blocks.length:
            let ([float32]'kernel'unified x_next, DecoderBlock b_next) = decoder_block_step_gpu(
                self.blocks[i], x_new, audio, seq_a, d, n_head)
            x_new = x_next
            next_blocks.push(b_next)
        self.blocks = next_blocks

        let [float32]'kernel'unified normed = layer_norm_seq_gpu(x_new, self.ln_w, self.ln_b, 1, d)
        linear_nobias_gpu(normed, self.tok_emb, 1, d, n_vocab)

    # Prompt prefill: updates KV cache for one prompt token without logit projection
    def forward_step_kv_only(int token_id, int pos, [float32]'kernel'global audio, int seq_a) throws:
        let int d      = self.d()
        let int n_head = self.n_head()
        guard pos < 448 else throw "decoder: sequence exceeds maximum context (448)"

        var [float32]'kernel'unified x_new = embed_token_step_gpu(self.tok_emb, self.pos_emb, token_id, pos, d)

        mut [DecoderBlock] next_blocks = []
        for i in 0..<self.blocks.length:
            let ([float32]'kernel'unified x_next, DecoderBlock b_next) = decoder_block_step_gpu(
                self.blocks[i], x_new, audio, seq_a, d, n_head)
            x_new = x_next
            next_blocks.push(b_next)
        self.blocks = next_blocks

    # Incremental step returning the next token ID directly via GPU argmax (no 51865-logit CPU readback)
    def int forward_step_token_gpu(int token_id, int pos, [float32]'kernel'global audio, int seq_a) throws:
        let int d       = self.d()
        let int n_head  = self.n_head()
        let int n_vocab = self.n_vocab()
        guard pos < 448 else throw "decoder: sequence exceeds maximum context (448)"

        var [float32]'kernel'unified x_new = embed_token_step_gpu(self.tok_emb, self.pos_emb, token_id, pos, d)

        mut [DecoderBlock] next_blocks = []
        for i in 0..<self.blocks.length:
            let ([float32]'kernel'unified x_next, DecoderBlock b_next) = decoder_block_step_gpu(
                self.blocks[i], x_new, audio, seq_a, d, n_head)
            x_new = x_next
            next_blocks.push(b_next)
        self.blocks = next_blocks

        let [float32]'kernel'unified normed = layer_norm_seq_gpu(x_new, self.ln_w, self.ln_b, 1, d)
        let [float32]'kernel'unified logits = linear_nobias_gpu(normed, self.tok_emb, 1, d, n_vocab)
        argmax_gpu(logits, n_vocab)

    # Greedy decode: generate tokens until EOT or max_new_tokens.
    def [int] generate([float32]'kernel'global audio, int seq_a, int max_new_tokens) throws:
        set_gpu_batch_limit(8)
        let int d = self.d()
        mut [DecoderBlock] cached_blocks = []
        for b in self.blocks:
            cached_blocks.push(ensure_cross_kv_gpu(b, audio, seq_a, d))
        self.blocks = cached_blocks

        let [int] prompt = [TOK_SOT, TOK_LANG_EN, TOK_TRANSCRIBE, TOK_NO_TIMESTAMPS]

        var int pos = 0
        # Prompt tokens 0..2: KV-cache prefill only (skip unnecessary vocab projection)
        for i in 0..<(prompt.length - 1):
            self.forward_step_kv_only(prompt[i], pos, audio, seq_a)
            pos += 1

        # Last prompt token: predict the first new token on GPU
        var int next_id = self.forward_step_token_gpu(prompt[prompt.length - 1], pos, audio, seq_a)
        pos += 1

        mut [int] generated = []
        var int steps = 0
        while steps < max_new_tokens:
            if next_id == TOK_EOT: break
            generated.push(next_id)
            steps += 1
            next_id = self.forward_step_token_gpu(next_id, pos, audio, seq_a)
            pos += 1

        set_gpu_batch_limit(1)
        generated
