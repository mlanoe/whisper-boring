# Isolates whether passing a STRUCT FIELD array (self.w) as an argument to
# linear_nobias_gpu at vocab scale (d_out = 51865) matches CPU reference.
use io
use math
use math_gpu

let int D_IN  = 384
let int D_OUT = 51865

pub req [float32] mk(int n, float32 scale, float32 bias):
    mut [float32] out = []
    for i in 0..<n:
        out.push((((i * 37 + 11) % 97) as float32 / 97.0) * scale - bias)
    out

struct Holder:
    [float32]'kernel'unified w

    req [float32] project([float32] x, int d_in, int d_out) throws:
        linear_nobias_gpu(x, self.w, 1, d_in, d_out)

def main() throws:
    print "=== struct-field-array linear_gpu (blocks > 1) correctness ==="

    let [float32] x = mk(D_IN, 0.3, 0.1)
    let [float32] w = mk(D_IN * D_OUT, 0.2, 0.1)

    let Holder h = Holder(w = upload_floats_gpu(w))
    let [float32] gpu_out = h.project(x, D_IN, D_OUT)

    mut [float32] cpu_out = []
    for o in 0..<D_OUT:
        var float32 acc = 0.0
        for i in 0..<D_IN:
            acc += x[i] * w[o * D_IN + i]
        cpu_out.push(acc)

    var float32 max_diff = 0.0
    var int worst = 0
    var int o = 0
    while o < D_OUT:
        let dd = if cpu_out[o] > gpu_out[o]: cpu_out[o] - gpu_out[o] else: gpu_out[o] - cpu_out[o]
        if dd > max_diff:
            max_diff = dd
            worst = o
        o += 1

    print "gpu_out[0]={gpu_out[0]:.6f} cpu_out[0]={cpu_out[0]:.6f}"
    print "gpu_out[57]={gpu_out[57]:.6f} cpu_out[57]={cpu_out[57]:.6f}"
    print "gpu_out[1000]={gpu_out[1000]:.6f} cpu_out[1000]={cpu_out[1000]:.6f}"
    print "gpu_out[25000]={gpu_out[25000]:.6f} cpu_out[25000]={cpu_out[25000]:.6f}"
    print "gpu_out[49999]={gpu_out[49999]:.6f} cpu_out[49999]={cpu_out[49999]:.6f}"
    print "gpu_out[51864]={gpu_out[51864]:.6f} cpu_out[51864]={cpu_out[51864]:.6f}"
    print "max diff = {max_diff:.8f} at index {worst}"
    guard max_diff < 1e-4 else throw "struct field linear_gpu diverged: {max_diff}"
