# src/math_gpu.br — GPU-accelerated transformer math (float32)
#
# Build targets:
#   boring build --target metal  # Apple GPU (macOS / iOS)
#   boring build --target wgpu   # DirectX 12 / Vulkan / Metal (cross-platform)
#   boring build --target cuda   # NVIDIA GPU
#   boring build --target simd   # Portable multi-threaded CPU SIMD
#
# Interpreter simulation:
#   boring run test/test_math_gpu.br

use math

# Metal command-buffer batching control (no-op on other backends).
pub def set_gpu_batch_limit(int limit): native

# ── One-time upload: host array -> GPU-resident buffer ───────────────────────

pub req [float32]'kernel'unified upload_floats_gpu([float32]'kernel'global src) throws:
    let int n = src.length
    let int blocks = (n + 255) / 256
    let int gx = if blocks > 65535: 65535 elif blocks > 0: blocks else: 1
    let int gy = (blocks + gx - 1) / gx
    kernel(block = 256, grid = (gx, gy)):
        mut [float32]'unified out = [0.0 as float32 for ..<n]
        let block_idx = .block.x + .block.y * .grid_dim.x
        let i = .thread.x + block_idx * .block_dim.x
        if i < n:
            out[i] = src[i]
        out

# ── Elementwise add (GPU-resident residual connection) ───────────────────────

pub req [float32]'kernel'unified add_gpu([float32]'kernel'global a, [float32]'kernel'global b, int n) throws:
    let int blocks = (n + 255) / 256
    let int gx = if blocks > 65535: 65535 elif blocks > 0: blocks else: 1
    let int gy = (blocks + gx - 1) / gx
    kernel(block = 256, grid = (gx, gy)):
        mut [float32]'unified out = [0.0 as float32 for ..<n]
        let block_idx = .block.x + .block.y * .grid_dim.x
        let i = .thread.x + block_idx * .block_dim.x
        if i < n:
            out[i] = a[i] + b[i]
        out

# ── KV-cache append on GPU ───────────────────────────────────────────────────

pub req [float32]'kernel'unified kv_append_gpu([float32]'kernel'global prev, [float32]'kernel'global fresh,
                                            int old_n, int new_n) throws:
    let int total = old_n + new_n
    let int blocks = (total + 255) / 256
    let int gx = if blocks > 65535: 65535 elif blocks > 0: blocks else: 1
    let int gy = (blocks + gx - 1) / gx
    kernel(block = 256, grid = (gx, gy)):
        mut [float32]'unified out = [0.0 as float32 for ..<total]
        let block_idx = .block.x + .block.y * .grid_dim.x
        let i = .thread.x + block_idx * .block_dim.x
        if i < total:
            if i < old_n:
                out[i] = prev[i]
            else:
                out[i] = fresh[i - old_n]
        out

# ── Single-token embedding + positional embedding on GPU ─────────────────────

pub req [float32]'kernel'unified embed_token_step_gpu([float32]'kernel'global tok_emb, [float32]'kernel'global pos_emb,
                                                   int token_id, int pos, int d) throws:
    let int blocks = (d + 255) / 256
    let int tok_base = token_id * d
    let int pos_base = pos * d
    kernel(block = 256, grid = blocks):
        mut [float32]'unified out = [0.0 as float32 for ..<d]
        let j = .thread.x + .block.x * .block_dim.x
        if j < d:
            out[j] = tok_emb[tok_base + j] + pos_emb[pos_base + j]
        out

# ── Sequence-tokens embedding + positional embedding on GPU (fused single launch) ─

pub req [float32]'kernel'unified embed_tokens_sequence_gpu([float32]'kernel'global tok_emb, [float32]'kernel'global pos_emb,
                                                           [int]'kernel'global tokens, int seq_t, int d) throws:
    let int total = seq_t * d
    let int blocks = (total + 255) / 256
    kernel(block = 256, grid = blocks):
        mut [float32]'unified out = [0.0 as float32 for ..<total]
        let idx = .thread.x + .block.x * .block_dim.x
        if idx < total:
            let t = idx / d
            let j = idx % d
            let tok_base = tokens[t] * d
            let pos_base = t * d
            out[idx] = tok_emb[tok_base + j] + pos_emb[pos_base + j]
        out

# ── Slice single row from (seq × d) GPU buffer ───────────────────────────────

pub req [float32]'kernel'unified slice_row_gpu([float32]'kernel'global x, int row, int d) throws:
    let int blocks = (d + 255) / 256
    let int base = row * d
    kernel(block = 256, grid = blocks):
        mut [float32]'unified out = [0.0 as float32 for ..<d]
        let j = .thread.x + .block.x * .block_dim.x
        if j < d:
            out[j] = x[base + j]
        out

# ── Kernel: matrix transpose ──────────────────────────────────────────────────

kernel TransposeKernel:
    let  [float32, col, row]'global   src      # (rows × cols)
    mut  [float32, col, row]'unified  dst      # output: (cols × rows)

    init([float32]'global s, int rows, int cols):
        src = s.reshape(col = cols, row = rows)
        dst = [0.0 as float32 for col = rows, row = cols]

    def ():
        let block_idx = .block.x + .block.y * .grid_dim.x
        let cell = .thread.x + block_idx * .block_dim.x
        if cell < src.col * src.row:
            let i = cell / src.col
            let j = cell % src.col
            dst[col = i, row = j] = src[col = j, row = i]

pub req [float32]'kernel'unified transpose_gpu([float32]'kernel'global src, int rows, int cols) throws:
    let int n_cells = rows * cols
    let int blocks  = (n_cells + 255) / 256
    let int gx = if blocks > 65535: 65535 elif blocks > 0: blocks else: 1
    let int gy = (blocks + gx - 1) / gx
    mut k = TransposeKernel(src, rows, cols)
    kernel:
        k(block = 256, grid = (gx, gy))
    k.dst

# ── Linear layer via native `kernel.tensors.linear` (y = x·Wᵀ + b) ───────────
# `w` is in standard PyTorch / WBRF (d_out × d_in) row-major layout directly —
# no caller-side pre-transposition required.

pub req [float32]'kernel'unified linear_gpu([float32]'kernel'global x, [float32]'kernel'global w, [float32]'kernel'global bv,
                       int seq, int d_in, int d_out) throws:
    mut [float32]'kernel'unified y = [0.0 as float32 for ..<seq * d_out]
    kernel.tensors.linear(x, w, bv, y, m = seq, n = d_out, k = d_in)
    y

pub req [float32]'kernel'unified linear_nobias_gpu([float32]'kernel'global x, [float32]'kernel'global w,
                       int seq, int d_in, int d_out) throws:
    mut [float32]'kernel'unified y = [0.0 as float32 for ..<seq * d_out]
    kernel.tensors.linear(x, w, y, m = seq, n = d_out, k = d_in)
    y

# ── Fused FlashAttention for d_head = 64 (seq_q > 1) ─────────────────────────
# Eliminates K transposition and the (n_head × seq_q × seq_k) intermediate score
# matrix by walking keys 16 at a time with online softmax. All Whisper models
# (Tiny, Base, Small, Medium) use d_head = 64.

kernel FlashAttn64Kernel:
    let  [float32, col, row]'global   q          # (seq_q × n_head*64)
    let  [float32, col, row]'global   k          # (seq_k × n_head*64)
    let  [float32, col, row]'global   v          # (seq_k × n_head*64)
    mut  [float32, col, row]'unified  o          # (seq_q × n_head*64)
    let int             seq_q
    let int             seq_k
    let float32         scale
    let int             causal
    mut [float32, width = 64, height = 16]'actor q_tile
    mut [float32, width = 64, height = 16]'actor k_tile
    mut [float32, width = 64, height = 16]'actor v_tile
    mut [float32, width = 16, height = 16]'actor p_tile
    mut [float32, 4] acc

    init([float32]'global qi, [float32]'global ki, [float32]'global vi,
         int sq, int sk, int d_full, float32 sc, int caus):
        q      = qi.reshape(col = d_full, row = sq)
        k      = ki.reshape(col = d_full, row = sk)
        v      = vi.reshape(col = d_full, row = sk)
        o      = [0.0 as float32 for col = d_full, row = sq]
        seq_q  = sq
        seq_k  = sk
        scale  = sc
        causal = caus

    def ():
        let tx    = .thread.x
        let ty    = .thread.y
        let h     = .block.z
        let row0  = .block.y * 16
        let i     = row0 + ty
        let q_off = h * 64
        for r in 0..<4:
            let idx = ty * 16 + tx + r * 256
            let rr = idx / 64
            let cc = idx % 64
            if row0 + rr < seq_q:
                q_tile[width = cc, height = rr] = q[col = q_off + cc, row = row0 + rr]
            else:
                q_tile[width = cc, height = rr] = 0.0
        for e in 0..<4:
            acc[e] = 0.0
        var float32 m = -1.0e30
        var float32 l = 0.0
        var int kmax = seq_k
        if causal == 1:
            let lim = row0 + 16
            if lim < kmax:
                kmax = lim
        let ntiles = (kmax + 15) / 16
        for t in 0..<ntiles:
            let j0 = t * 16
            sync
            for r in 0..<4:
                let idx = ty * 16 + tx + r * 256
                let rr = idx / 64
                let cc = idx % 64
                if j0 + rr < seq_k:
                    k_tile[width = cc, height = rr] = k[col = q_off + cc, row = j0 + rr]
                    v_tile[width = cc, height = rr] = v[col = q_off + cc, row = j0 + rr]
                else:
                    k_tile[width = cc, height = rr] = 0.0
                    v_tile[width = cc, height = rr] = 0.0
            sync
            var float32 s = 0.0
            for d_idx in 0..<64:
                s += q_tile[width = d_idx, height = ty] * k_tile[width = d_idx, height = tx]
            s = s * scale
            let jg = j0 + tx
            var int ok = 1
            if jg >= seq_k:
                ok = 0
            if causal == 1 and jg > i:
                ok = 0
            if ok == 0:
                s = -1.0e30 as float32
            p_tile[width = tx, height = ty] = s
            sync
            var float32 mx = m
            for j in 0..<16:
                let sv = p_tile[width = j, height = ty]
                if sv > mx:
                    mx = sv
            let alpha = (m - mx).exp()
            var float32 pv = 0.0
            if ok == 1:
                pv = (s - mx).exp()
            sync
            p_tile[width = tx, height = ty] = pv
            sync
            for e in 0..<4:
                acc[e] = acc[e] * alpha
            var float32 psum = 0.0
            for j in 0..<16:
                let pj = p_tile[width = j, height = ty]
                psum += pj
                for e in 0..<4:
                    acc[e] += pj * v_tile[width = tx + 16 * e, height = j]
            l = l * alpha + psum
            m = mx
        if i < seq_q:
            var float32 inv = 0.0
            if l > 0.0:
                inv = 1.0 / l
            for e in 0..<4:
                o[col = q_off + tx + 16 * e, row = i] = acc[e] * inv

pub req [float32]'kernel'unified attention_flash64_gpu([float32]'kernel'global q, [float32]'kernel'global k, [float32]'kernel'global v,
                          int seq_q, int seq_k, int n_head, bool causal) throws:
    let int d_full = n_head * 64
    let float32 scale = 1.0 / (64.0 as float32).sqrt()
    let int causal_i = if causal: 1 else: 0
    mut kf = FlashAttn64Kernel(q, k, v, seq_q, seq_k, d_full, scale, causal_i)
    kernel:
        kf(block = (16, 16), grid = (1, (seq_q + 15) / 16, n_head))
    kf.o

# ── Split-K FlashDecode for single-query decode (seq_q == 1, d_head = 64) ────
# Reads K and V directly from (seq_k × d) cache layout without transposing K.

kernel FlashDecode64Kernel:
    let  [float32]'global   q          # (n_head*64), single query row
    let  [float32]'global   k          # (seq_k * n_head*64)
    let  [float32]'global   v          # (seq_k * n_head*64)
    mut  [float32]'unified  part       # per (head, split): m, l, then 64 partial output dims
    let int             seq_k
    let int             d_full
    let int             nsplit
    let int             chunk
    let float32         scale
    mut [float32, width = 64, height = 1]'actor q_s
    mut [float32, width = 64, height = 1]'actor p_s

    init([float32]'global qi, [float32]'global ki, [float32]'global vi,
         int sk, int df, int ns, int ch, float32 sc, int nparts):
        q      = qi
        k      = ki
        v      = vi
        seq_k  = sk
        d_full = df
        nsplit = ns
        chunk  = ch
        scale  = sc
        part   = [0.0 as float32 for ..<nparts]

    def ():
        let t     = .thread.x
        let split = .block.x
        let h     = .block.y
        let k_off = h * 64
        let start = split * chunk
        var int stop = start + chunk
        if stop > seq_k:
            stop = seq_k
        q_s[width = t, height = 0] = q[h * 64 + t]
        var float32 m = -1.0e30
        var float32 l = 0.0
        var float32 acc = 0.0
        var int ntiles = 0
        if stop > start:
            ntiles = (stop - start + 63) / 64
        for ti in 0..<ntiles:
            let j0 = start + ti * 64
            let jg = j0 + t
            sync
            var float32 s = -1.0e30
            if jg < stop:
                var float32 dot = 0.0
                for d_idx in 0..<64:
                    dot += q_s[width = d_idx, height = 0] * k[jg * d_full + k_off + d_idx]
                s = dot * scale
            p_s[width = t, height = 0] = s
            sync
            var float32 mx = m
            for j in 0..<64:
                let sv = p_s[width = j, height = 0]
                if sv > mx:
                    mx = sv
            let alpha = (m - mx).exp()
            var float32 pv = 0.0
            if jg < stop:
                pv = (s - mx).exp()
            sync
            p_s[width = t, height = 0] = pv
            sync
            var float32 psum = 0.0
            var float32 nacc = 0.0
            for j in 0..<64:
                let pj = p_s[width = j, height = 0]
                psum += pj
                if j0 + j < stop:
                    nacc += pj * v[(j0 + j) * d_full + k_off + t]
            l = l * alpha + psum
            acc = acc * alpha + nacc
            m = mx
        let base = (h * nsplit + split) * 66
        part[base + 2 + t] = acc
        if t == 0:
            part[base] = m
            part[base + 1] = l

kernel FlashDecodeCombine64Kernel:
    let  [float32]'global   part
    mut  [float32]'unified  o          # (n_head*64)
    let int             nsplit

    init([float32]'global pi, int ns, int n):
        part   = pi
        nsplit = ns
        o      = [0.0 as float32 for ..<n]

    def ():
        let t = .thread.x
        let h = .block.x
        var float32 big = -1.0e30
        for s in 0..<nsplit:
            let ms = part[(h * nsplit + s) * 66]
            if ms > big:
                big = ms
        var float32 total = 0.0
        var float32 a = 0.0
        for s in 0..<nsplit:
            let base = (h * nsplit + s) * 66
            let w = (part[base] - big).exp()
            total += part[base + 1] * w
            a += part[base + 2 + t] * w
        var float32 res = 0.0
        if total > 0.0:
            res = a / total
        o[h * 64 + t] = res

pub req [float32]'kernel'unified attention_decode64_gpu([float32]'kernel'global q, [float32]'kernel'global k, [float32]'kernel'global v,
                          int seq_k, int n_head) throws:
    let int d_full = n_head * 64
    let float32 scale = 1.0 / (64.0 as float32).sqrt()
    var int nsplit = (seq_k + 127) / 128
    if nsplit < 1:
        nsplit = 1
    if nsplit > 64:
        nsplit = 64
    let int chunk = (seq_k + nsplit - 1) / nsplit
    mut kd = FlashDecode64Kernel(q, k, v, seq_k, d_full, nsplit, chunk, scale, n_head * nsplit * 66)
    kernel:
        kd(block = 64, grid = (nsplit, n_head))
    mut kc = FlashDecodeCombine64Kernel(kd.part, nsplit, d_full)
    kernel:
        kc(block = 64, grid = n_head)
    kc.o

# ── Fallback 3-kernel attention for arbitrary d_head (e.g. unit tests) ───────

kernel MatMulBTHeadsKernel:
    let  [float32, col, row]'global   q          # (seq_q × d)
    let  [float32, col, row]'global   k          # (d × seq_k) — pre-transposed
    mut  [float32, j, i, h]'unified   c          # output: (n_head × seq_q × seq_k)
    let int             seq_q
    let int             seq_k
    let int             d_head
    let int             n_head
    let float32         scale
    let int             causal     # 0 = off, 1 = causal mask
    mut [float32, width = 16, height = 16]'actor tile_q
    mut [float32, width = 16, height = 16]'actor tile_k

    init([float32]'global qi, [float32]'global ki,
         int sq, int sk, int dd, int dh, int nh, float32 sc, int caus):
        q      = qi.reshape(col = dd, row = sq)
        k      = ki.reshape(col = sk, row = dd)
        seq_q  = sq
        seq_k  = sk
        d_head = dh
        n_head = nh
        scale  = sc
        causal = caus
        c      = [0.0 as float32 for j = sk, i = sq, h = nh]

    def ():
        let tx  = .thread.x
        let ty  = .thread.y
        let h   = .block.z
        let i   = .block.y * .block_dim.y + ty
        let j   = .block.x * .block_dim.x + tx
        let off = h * d_head
        var float32 s = 0.0
        let num_tiles = (d_head + 15) / 16
        for t in 0..<num_tiles:
            let p = t * 16
            if i < seq_q and (p + tx) < d_head:
                tile_q[width = tx, height = ty] = q[col = off + p + tx, row = i]
            else:
                tile_q[width = tx, height = ty] = 0.0
            if j < seq_k and (p + ty) < d_head:
                tile_k[width = tx, height = ty] = k[col = j, row = off + p + ty]
            else:
                tile_k[width = tx, height = ty] = 0.0
            sync
            for kk in 0..<16:
                s += tile_q[width = kk, height = ty] * tile_k[width = tx, height = kk]
            sync
        s = s / scale
        if causal == 1 and j > i:
            s = -1.0e9 as float32
        if i < seq_q and j < seq_k:
            c[j = j, i = i, h = h] = s

kernel SoftmaxRowsKernel:
    let  [float32, col, row]'global   scores_in
    mut  [float32, col, row]'unified  probs

    init([float32]'global s, int r, int c):
        scores_in = s.reshape(col = c, row = r)
        probs     = [0.0 as float32 for col = c, row = r]

    def ():
        let i = .thread.x + .block.x * .block_dim.x
        if i < probs.row:
            var float32 mx = scores_in[col = 0, row = i]
            for j in 0..<probs.col:
                if scores_in[col = j, row = i] > mx: mx = scores_in[col = j, row = i]
            var float32 total = 0.0
            for j in 0..<probs.col:
                let e = (scores_in[col = j, row = i] - mx).exp()
                probs[col = j, row = i] = e
                total += e
            for j in 0..<probs.col:
                probs[col = j, row = i] = probs[col = j, row = i] / total

kernel MatMulHeadsKernel:
    let  [float32, p, i, h]'global   probs      # (n_head × seq_q × seq_k)
    let  [float32, col, row]'global  v          # (seq_k × d)
    mut  [float32, col, row]'unified c          # output: (seq_q × d)
    let int             d_head
    let int             n_head

    init([float32]'global pi, [float32]'global vi,
         int sq, int sk, int dd, int dh, int nh):
        probs  = pi.reshape(p = sk, i = sq, h = nh)
        v      = vi.reshape(col = dd, row = sk)
        c      = [0.0 as float32 for col = dd, row = sq]
        d_head = dh
        n_head = nh

    def ():
        let cell = .thread.x + .block.x * .block_dim.x
        if cell < c.row * c.col:
            let i   = cell / c.col
            let col = cell % c.col
            let h   = col / d_head
            let jl  = col % d_head
            var float32 s = 0.0
            for p in 0..<v.row:
                s += probs[p = p, i = i, h = h] * v[col = h * d_head + jl, row = p]
            c[col = col, row = i] = s

pub req [float32]'kernel'unified attention_three_kernel_gpu([float32]'kernel'global q, [float32]'kernel'global k, [float32]'kernel'global v,
                          int seq_q, int seq_k, int d, int n_head,
                          bool causal) throws:
    let int d_head    = d / n_head
    let float32 scale = (d_head as float32).sqrt()
    let int causal_i  = if causal: 1 else: 0

    let [float32]'kernel'unified k_t = transpose_gpu(k, seq_k, d)

    let int score_gx = (seq_k + 15) / 16
    let int score_gy = (seq_q + 15) / 16
    mut k_scores = MatMulBTHeadsKernel(q, k_t, seq_q, seq_k, d, d_head, n_head, scale, causal_i)
    kernel:
        k_scores(block = (16, 16), grid = (score_gx, score_gy, n_head))

    let int soft_rows  = n_head * seq_q
    let int row_blocks = (soft_rows + 255) / 256
    mut k_soft = SoftmaxRowsKernel(k_scores.c, soft_rows, seq_k)
    kernel:
        k_soft(block = 256, grid = row_blocks)

    let int out_cells  = seq_q * d
    let int out_blocks = (out_cells + 255) / 256
    mut k_ctx = MatMulHeadsKernel(k_soft.probs, v, seq_q, seq_k, d, d_head, n_head)
    kernel:
        k_ctx(block = 256, grid = out_blocks)

    k_ctx.c

# Multi-head scaled dot-product attention (GPU). Dispatches d_head == 64 to
# FlashAttention (seq_q > 1) or FlashDecode (seq_q == 1, non-causal), and falls
# back to the 3-kernel path for arbitrary head sizes.
pub req [float32]'kernel'unified attention_heads_gpu([float32]'kernel'global q, [float32]'kernel'global k, [float32]'kernel'global v,
                          int seq_q, int seq_k, int d, int n_head,
                          bool causal) throws:
    let int d_head = d / n_head
    if d_head == 64 and seq_q > 1:
        attention_flash64_gpu(q, k, v, seq_q, seq_k, n_head, causal)
    elif d_head == 64 and seq_q == 1 and not causal:
        attention_decode64_gpu(q, k, v, seq_k, n_head)
    else:
        attention_three_kernel_gpu(q, k, v, seq_q, seq_k, d, n_head, causal)

# Multi-head attention (GPU) with explicit K bias.
pub req [float32]'kernel'unified mha_gpu([float32]'kernel'global x_q,  [float32]'kernel'global x_kv,
                    [float32]'kernel'global w_q,  [float32]'kernel'global b_q,
                    [float32]'kernel'global w_k,  [float32]'kernel'global b_k,
                    [float32]'kernel'global w_v,  [float32]'kernel'global b_v,
                    [float32]'kernel'global w_o,  [float32]'kernel'global b_o,
                    int seq_q, int seq_k, int d, int n_head,
                    bool causal) throws:
    let [float32]'kernel'unified Q = linear_gpu(x_q,  w_q, b_q, seq_q, d, d)
    let [float32]'kernel'unified K = linear_gpu(x_kv, w_k, b_k, seq_k, d, d)
    let [float32]'kernel'unified V = linear_gpu(x_kv, w_v, b_v, seq_k, d, d)

    let [float32]'kernel'unified concat = attention_heads_gpu(Q, K, V, seq_q, seq_k, d, n_head, causal)

    linear_gpu(concat, w_o, b_o, seq_q, d, d)

# Multi-head attention (GPU) without K bias (Whisper encoder/decoder pattern).
pub req [float32]'kernel'unified mha_nobias_k_gpu([float32]'kernel'global x_q,  [float32]'kernel'global x_kv,
                    [float32]'kernel'global w_q,  [float32]'kernel'global b_q,
                    [float32]'kernel'global w_k,
                    [float32]'kernel'global w_v,  [float32]'kernel'global b_v,
                    [float32]'kernel'global w_o,  [float32]'kernel'global b_o,
                    int seq_q, int seq_k, int d, int n_head,
                    bool causal) throws:
    let [float32]'kernel'unified Q = linear_gpu(x_q,  w_q, b_q, seq_q, d, d)
    let [float32]'kernel'unified K = linear_nobias_gpu(x_kv, w_k, seq_k, d, d)
    let [float32]'kernel'unified V = linear_gpu(x_kv, w_v, b_v, seq_k, d, d)

    let [float32]'kernel'unified concat = attention_heads_gpu(Q, K, V, seq_q, seq_k, d, n_head, causal)

    linear_gpu(concat, w_o, b_o, seq_q, d, d)

# ── Incremental (KV-cache) attention for greedy decoding (100% GPU-resident) ─

pub req ([float32]'kernel'unified, [float32]'kernel'unified, [float32]'kernel'unified) mha_step_gpu(
                    [float32]'kernel'global x_new,
                    [float32]'kernel'global w_q,  [float32]'kernel'global b_q,
                    [float32]'kernel'global w_k,  [float32]'kernel'global b_k,
                    [float32]'kernel'global w_v,  [float32]'kernel'global b_v,
                    [float32]'kernel'global w_o,  [float32]'kernel'global b_o,
                    [float32]'kernel'global cache_k, [float32]'kernel'global cache_v,
                    int d, int n_head) throws:
    let [float32]'kernel'unified q_new = linear_gpu(x_new, w_q, b_q, 1, d, d)
    let [float32]'kernel'unified k_new = linear_gpu(x_new, w_k, b_k, 1, d, d)
    let [float32]'kernel'unified v_new = linear_gpu(x_new, w_v, b_v, 1, d, d)

    let int old_n = cache_k.length
    let [float32]'kernel'unified new_cache_k = if old_n == 0: k_new else: kv_append_gpu(cache_k, k_new, old_n, d)
    let [float32]'kernel'unified new_cache_v = if old_n == 0: v_new else: kv_append_gpu(cache_v, v_new, old_n, d)
    let int seq_k = (old_n + d) / d

    let [float32]'kernel'unified concat = attention_heads_gpu(q_new, new_cache_k, new_cache_v, 1, seq_k, d, n_head, false)
    let [float32]'kernel'unified out = linear_gpu(concat, w_o, b_o, 1, d, d)
    (out, new_cache_k, new_cache_v)

pub req ([float32]'kernel'unified, [float32]'kernel'unified, [float32]'kernel'unified) mha_step_nobias_k_gpu(
                    [float32]'kernel'global x_new,
                    [float32]'kernel'global w_q,  [float32]'kernel'global b_q,
                    [float32]'kernel'global w_k,
                    [float32]'kernel'global w_v,  [float32]'kernel'global b_v,
                    [float32]'kernel'global w_o,  [float32]'kernel'global b_o,
                    [float32]'kernel'global cache_k, [float32]'kernel'global cache_v,
                    int d, int n_head) throws:
    let [float32]'kernel'unified q_new = linear_gpu(x_new, w_q, b_q, 1, d, d)
    let [float32]'kernel'unified k_new = linear_nobias_gpu(x_new, w_k, 1, d, d)
    let [float32]'kernel'unified v_new = linear_gpu(x_new, w_v, b_v, 1, d, d)

    let int old_n = cache_k.length
    let [float32]'kernel'unified new_cache_k = if old_n == 0: k_new else: kv_append_gpu(cache_k, k_new, old_n, d)
    let [float32]'kernel'unified new_cache_v = if old_n == 0: v_new else: kv_append_gpu(cache_v, v_new, old_n, d)
    let int seq_k = (old_n + d) / d

    let [float32]'kernel'unified concat = attention_heads_gpu(q_new, new_cache_k, new_cache_v, 1, seq_k, d, n_head, false)
    let [float32]'kernel'unified out = linear_gpu(concat, w_o, b_o, 1, d, d)
    (out, new_cache_k, new_cache_v)

pub req [float32]'kernel'unified mha_cross_step_gpu([float32]'kernel'global x_new,
                    [float32]'kernel'global w_q, [float32]'kernel'global b_q,
                    [float32]'kernel'global cache_k, [float32]'kernel'global cache_v,
                    [float32]'kernel'global w_o, [float32]'kernel'global b_o,
                    int seq_a, int d, int n_head) throws:
    let [float32]'kernel'unified q_new = linear_gpu(x_new, w_q, b_q, 1, d, d)
    let [float32]'kernel'unified concat = attention_heads_gpu(q_new, cache_k, cache_v, 1, seq_a, d, n_head, false)
    linear_gpu(concat, w_o, b_o, 1, d, d)

# ── Batched prompt prefill attention (populates initial KV-cache in 1 pass) ──

pub req ([float32]'kernel'unified, [float32]'kernel'unified, [float32]'kernel'unified) mha_prefill_nobias_k_gpu(
                    [float32]'kernel'global x,
                    [float32]'kernel'global w_q,  [float32]'kernel'global b_q,
                    [float32]'kernel'global w_k,
                    [float32]'kernel'global w_v,  [float32]'kernel'global b_v,
                    [float32]'kernel'global w_o,  [float32]'kernel'global b_o,
                    int seq_t, int d, int n_head) throws:
    let [float32]'kernel'unified Q = linear_gpu(x, w_q, b_q, seq_t, d, d)
    let [float32]'kernel'unified K = linear_nobias_gpu(x, w_k, seq_t, d, d)
    let [float32]'kernel'unified V = linear_gpu(x, w_v, b_v, seq_t, d, d)
    let [float32]'kernel'unified concat = attention_heads_gpu(Q, K, V, seq_t, seq_t, d, n_head, true)
    let [float32]'kernel'unified out = linear_gpu(concat, w_o, b_o, seq_t, d, d)
    (out, K, V)

pub req [float32]'kernel'unified mha_cross_prefill_gpu(
                    [float32]'kernel'global x,
                    [float32]'kernel'global w_q, [float32]'kernel'global b_q,
                    [float32]'kernel'global cache_k, [float32]'kernel'global cache_v,
                    [float32]'kernel'global w_o, [float32]'kernel'global b_o,
                    int seq_t, int seq_a, int d, int n_head) throws:
    let [float32]'kernel'unified Q = linear_gpu(x, w_q, b_q, seq_t, d, d)
    let [float32]'kernel'unified concat = attention_heads_gpu(Q, cache_k, cache_v, seq_t, seq_a, d, n_head, false)
    linear_gpu(concat, w_o, b_o, seq_t, d, d)

# ── Kernel: LayerNorm (row-wise warp-shuffle reduction, 32 threads/row) ──────

pub req [float32]'kernel'unified layer_norm_seq_gpu([float32]'kernel'global x, [float32]'kernel'global w, [float32]'kernel'global b,
                               int seq, int d) throws:
    let int gx = if seq > 0: seq else: 1
    kernel(block = 32, grid = gx):
        mut [float32]'unified out = [0.0 as float32 for ..<seq * d]
        let lane = .warp.lane
        let row = .block.x
        let base = row * d
        var float32 s = 0.0
        var int jm = lane
        while jm < d:
            s += x[base + jm]
            jm += .warp.size
        var int om = .warp.size / 2
        while om > 0:
            s += .warp.shuffle_xor(s, om)
            om = om / 2
        let mu = s / (d as float32)
        var float32 ss = 0.0
        var int j = lane
        while j < d:
            let diff = x[base + j] - mu
            ss += diff * diff
            j += .warp.size
        var int offset = .warp.size / 2
        while offset > 0:
            ss += .warp.shuffle_xor(ss, offset)
            offset = offset / 2
        let sd = (ss / (d as float32) + 1e-5).sqrt()
        j = lane
        while j < d:
            out[base + j] = w[j] * (x[base + j] - mu) / sd + b[j]
            j += .warp.size
        out

# Fused single-token residual add + LayerNorm (returns both residual and normed).
pub req ([float32]'kernel'unified, [float32]'kernel'unified) add_layer_norm_decode_gpu(
        [float32]'kernel'global a, [float32]'kernel'global b,
        [float32]'kernel'global w, [float32]'kernel'global bv, int d) throws:
    kernel(block = 32, grid = 1):
        mut [float32]'unified residual = [0.0 as float32 for ..<d]
        mut [float32]'unified normed   = [0.0 as float32 for ..<d]
        let lane = .warp.lane
        var float32 s = 0.0
        var int jm = lane
        while jm < d:
            s += a[jm] + b[jm]
            jm += .warp.size
        var int om = .warp.size / 2
        while om > 0:
            s += .warp.shuffle_xor(s, om)
            om = om / 2
        let mu = s / (d as float32)
        var float32 ss = 0.0
        var int j = lane
        while j < d:
            let v = (a[j] + b[j]) - mu
            ss += v * v
            j += .warp.size
        var int offset = .warp.size / 2
        while offset > 0:
            ss += .warp.shuffle_xor(ss, offset)
            offset = offset / 2
        let sd = (ss / (d as float32) + 1e-5).sqrt()
        j = lane
        while j < d:
            let v = a[j] + b[j]
            residual[j] = v
            normed[j] = w[j] * (v - mu) / sd + bv[j]
            j += .warp.size
        (residual, normed)

# ── Kernel: GELU (elementwise) ────────────────────────────────────────────────

kernel GeluKernel:
    let [float32]'global   x
    mut [float32]'unified  out
    let int                n

    init([float32]'global xi, int ni):
        x   = xi
        n   = ni
        out = [0.0 as float32 for ..<ni]

    def ():
        let block_idx = .block.x + .block.y * .grid_dim.x
        let i = .thread.x + block_idx * .block_dim.x
        if i < n:
            let v = x[i]
            out[i] = 0.5 * v * (1.0 + (0.7978845608 * (v + 0.044715 * v * v * v)).tanh())

pub req [float32]'kernel'unified gelu_gpu([float32]'kernel'global x) throws:
    let int n      = x.length
    let int blocks = (n + 255) / 256
    let int gx     = if blocks > 65535: 65535 elif blocks > 0: blocks else: 1
    let int gy     = (blocks + gx - 1) / gx
    mut k = GeluKernel(x, n)
    kernel:
        k(block = 256, grid = (gx, gy))
    k.out

# ── Kernel: 1D convolution (same-padding, general stride) ───────────────────

kernel Conv1dKernel:
    let [float32]'global   x        # (t_in × c_in)
    let [float32]'global   w        # (c_out × c_in × k)
    let [float32]'global   bv       # (c_out,)
    mut [float32]'unified  out      # (t_out × c_out)
    let int                t_in
    let int                c_in
    let int                c_out
    let int                k
    let int                stride
    let int                t_out

    init([float32]'global xi, [float32]'global wi, [float32]'global bi,
         int ti, int ci, int co, int kk, int st, int to):
        x      = xi
        w      = wi
        bv     = bi
        t_in   = ti
        c_in   = ci
        c_out  = co
        k      = kk
        stride = st
        t_out  = to
        out    = [0.0 as float32 for ..<to * co]

    def ():
        let block_idx = .block.x + .block.y * .grid_dim.x
        let cell = .thread.x + block_idx * .block_dim.x
        if cell < t_out * c_out:
            let i    = cell / c_out
            let oc   = cell % c_out
            let pad  = k / 2
            let src0 = i * stride
            var float32 s = bv[oc]
            for ic in 0..<c_in:
                for ki in 0..<k:
                    let si = src0 + ki - pad
                    if si >= 0 and si < t_in:
                        s += x[si * c_in + ic] * w[oc * c_in * k + ic * k + ki]
            out[cell] = s

pub req [float32]'kernel'unified conv1d_gpu([float32]'kernel'global x, [float32]'kernel'global w, [float32]'kernel'global bv,
                       int t_in, int c_in, int c_out, int k,
                       int stride, int t_out) throws:
    let int n_cells = t_out * c_out
    let int blocks  = (n_cells + 255) / 256
    let int gx      = if blocks > 65535: 65535 elif blocks > 0: blocks else: 1
    let int gy      = (blocks + gx - 1) / gx
    mut kk = Conv1dKernel(x, w, bv, t_in, c_in, c_out, k, stride, t_out)
    kernel:
        kk(block = 256, grid = (gx, gy))
    kk.out

# ── Kernel: ArgMax (greedy token decoding) ───────────────────────────────────
# Computes the index of the maximum value in a vector of logits on GPU.
# Stage 1: 256 threads scan the entire logits array with stride 256.
# Each thread t writes its local best (value and index) into part_val[t] and part_idx[t].
kernel ArgMaxStage1Kernel:
    let [float32]'global  logits
    mut [float32]'unified part_val
    mut [int]'unified     part_idx
    let int n

    init([float32]'global l, int ni):
        logits   = l
        n        = ni
        part_val = [0.0 as float32 for ..<256]
        part_idx = [0 for ..<256]

    def ():
        let tid = .thread.x
        var float32 best_v = -1.0e30 as float32
        var int best_i = 0
        var int i = tid
        while i < n:
            let float32 v = logits[i]
            if v > best_v:
                best_v = v
                best_i = i
            i += 256
        part_val[tid] = best_v
        part_idx[tid] = best_i

# Stage 2: 1 thread reduces the 256 candidates to the single best token ID.
kernel ArgMaxStage2Kernel:
    let [float32]'global part_val
    let [int]'global     part_idx
    mut [int]'unified    best_out

    init([float32]'global pv, [int]'global pi):
        part_val = pv
        part_idx = pi
        best_out = [0]

    def ():
        var float32 best_v = part_val[0]
        var int best_i = part_idx[0]
        for i in 1..<256:
            let float32 v = part_val[i]
            if v > best_v:
                best_v = v
                best_i = part_idx[i]
        best_out[0] = best_i

pub req int argmax_gpu([float32]'kernel'global logits, int n) throws:
    mut k1 = ArgMaxStage1Kernel(logits, n)
    kernel:
        k1(block = 256, grid = 1)
    mut k2 = ArgMaxStage2Kernel(k1.part_val, k1.part_idx)
    kernel:
        k2(block = 1, grid = 1)
    let [int] out = k2.best_out
    out[0]

