# src/audio_gpu.br — GPU-accelerated STFT and log-mel spectrogram
#
# Build targets:
#   boring build --target cuda   # NVIDIA GPU
#   boring build --target wgpu   # DirectX 12 / Vulkan / Metal (cross-platform)
#   boring build --target metal  # Apple GPU (macOS / iOS)
#   boring build --target simd   # Portable multi-threaded CPU SIMD
#
# Interpreter simulation (sequential, for development):
#   boring run test/test_mel_gpu.br

use math
use audio

# ── Kernel 1: STFT → power spectrum ──────────────────────────────────────────
# Grid: ceil(n_frames / 256) blocks.   Block: 256 threads.
# Thread (block.x * block_dim.x + thread.x) handles one STFT frame.

kernel StftPower:
    let [float32]'global  audio      # reflect-padded audio
    let [float32]'global  win        # Hann window (n_fft values)
    mut [float32, freq, frame]'unified power # output: n_freq × n_frames power values
    let int               hop
    let int               n_padded
    let int               n_fft

    init([float32]'global a, [float32]'global w, int nf, int h, int np, int nfft, int nfreq):
        audio    = a
        win      = w
        hop      = h
        n_padded = np
        n_fft    = nfft
        power    = [0.0 as float32 for freq = nfreq, frame = nf]

    def ():
        let frame = .thread.x + .block.x * .block_dim.x
        if frame < power.frame:
            let start = frame * hop

            # Direct DFT: one-sided power spectrum (n_freq bins)
            for k in 0..<power.freq:
                var float32 re = 0.0 as float32
                var float32 im = 0.0 as float32
                for i in 0..<n_fft:
                    let float32 s = if start + i < n_padded: audio[start + i] * win[i] else: (0.0 as float32)
                    let float32 ang = -2.0 * PI * ((k * i % n_fft) as float32) / (n_fft as float32)
                    re += s * ang.cos()
                    im += s * ang.sin()
                power[freq = k, frame = frame] = re * re + im * im


# ── Kernel 2: Mel filterbank dot-product ──────────────────────────────────────
# Grid: ceil(n_frames / 256) blocks.   Block: 256 threads.
# One thread per STFT frame.

kernel MelApply:
    let [float32, freq, mel]'global   fb    # filterbank: n_freq × n_mels  (201 × 80)
    let [float32, freq, frame]'global power # STFT power:  n_freq × n_frames
    mut [float32, frame, mel]'unified mel   # output: n_frames × n_mels

    init([float32]'global f, [float32]'global p, int nm, int nf, int nfq):
        fb    = f.reshape(freq = nfq, mel = nm)
        power = p.reshape(freq = nfq, frame = nf)
        mel   = [0.0 as float32 for frame = nf, mel = nm]

    def ():
        let f = .thread.x + .block.x * .block_dim.x
        if f < mel.frame:
            for m in 0..<mel.mel:
                var float32 s = 0.0
                for k in 0..<fb.freq:
                    s += fb[freq = k, mel = m] * power[freq = k, frame = f]
                mel[frame = f, mel = m] = s


# ── Kernel 3: Log compression ─────────────────────────────────────────────────
# Grid: ceil(n_frames / 256) blocks.   Block: 256 threads.

kernel LogCompress:
    let [float32, frame, mel]'global  mel_in
    mut [float32, frame, mel]'unified mel_out
    let float32                       clamp_val

    init([float32]'global inp, float32 cv, int nm, int nf):
        mel_in    = inp.reshape(frame = nf, mel = nm)
        mel_out   = [0.0 as float32 for frame = nf, mel = nm]
        clamp_val = cv

    def ():
        let f = .thread.x + .block.x * .block_dim.x
        if f < mel_in.frame:
            for m in 0..<mel_in.mel:
                let float32 v = if mel_in[frame = f, mel = m] > clamp_val: mel_in[frame = f, mel = m] else: clamp_val
                mel_out[frame = f, mel = m] = v.log10()


# ── GPU log-mel spectrogram ───────────────────────────────────────────────────
# Drop-in replacement for log_mel_spectrogram() in audio.br.

# Cached precomputed tables for Whisper standard audio (400-point Hann, 80-mel filterbank)
var [float32] CACHED_HANN_400 = []
var [float32] CACHED_MEL_FB_80 = []

pub req [float32] get_cached_hann_400():
    if CACHED_HANN_400.length == 0:
        CACHED_HANN_400 = hann_window(400)
    CACHED_HANN_400

pub req [float32] get_cached_mel_fb_80():
    if CACHED_MEL_FB_80.length == 0:
        CACHED_MEL_FB_80 = mel_filterbank(80, 400, 16000)
    CACHED_MEL_FB_80

pub req MelSpectrogram log_mel_spectrogram_gpu([float32] audio) throws:
    let int n_audio = audio.length
    let int n_fft   = 400
    let int hop     = 160
    let int n_mels  = 80
    let int n_freq  = n_fft / 2 + 1
    let int pad     = n_fft / 2

    # Reflect-pad audio
    mut [float32] padded = []
    for i in 0..<pad:
        let int src = pad - i
        padded.push(if src < n_audio: audio[src] else: (0.0 as float32))
    for v in audio: padded.push(v)
    for i in 0..<pad:
        let int src = n_audio - 2 - i
        padded.push(if src >= 0 and src < n_audio: audio[src] else: (0.0 as float32))

    let int n_padded = padded.length
    let int n_frames = (n_padded - n_fft) / hop
    guard n_frames > 0 else throw "audio too short (<10ms) for mel spectrogram"

    let [float32] win = if n_fft == 400: get_cached_hann_400() else: hann_window(n_fft)
    let [float32] fb  = if n_mels == 80 and n_fft == 400: get_cached_mel_fb_80() else: mel_filterbank(n_mels, n_fft, 16000)

    # ── STFT (one thread per frame) ──────────────────────────────────────────
    let int stft_blocks = (n_frames + 255) / 256
    mut k_stft = StftPower(padded, win, n_frames, hop, n_padded, n_fft, n_freq)
    kernel:
        k_stft(block = 256, grid = stft_blocks)

    # ── Mel filterbank (one thread per frame) ────────────────────────────────
    let int mel_blocks = (n_frames + 255) / 256
    mut k_mel = MelApply(fb, k_stft.power, n_mels, n_frames, n_freq)
    kernel:
        k_mel(block = 256, grid = mel_blocks)

    # ── Log compression (one thread per frame) ────────────────────────────────
    let [float32]'kernel'unified mel_raw = k_mel.mel
    let float32 clamp_val = 1e-10

    mut k_log = LogCompress(mel_raw, clamp_val, n_mels, n_frames)
    kernel:
        k_log(block = 256, grid = mel_blocks)

    let [float32] mel_log = k_log.mel_out

    # ── Normalize (global max → CPU reduction) ────────────────────────────────
    var float32 log_max = mel_log[0]
    for v in mel_log:
        if v > log_max: log_max = v
    let float32 floor_ = log_max - 8.0

    # Pad or trim to N_FRAMES = 3000 columns
    if n_frames > 3000:
        let float32 total_secs = ((n_frames * hop) as float32) / (SAMPLE_RATE as float32)
        warn "audio is {total_secs:.1f}s, truncating to the first 30s (no windowed chunking yet)"
    let int cols = if n_frames < 3000: n_frames else: 3000
    mut [float32] fixed = zeros(n_mels * 3000)
    for m in 0..<n_mels:
        for f in 0..<cols:
            let float32 raw    = mel_log[m * n_frames + f]
            let float32 normed = ((if raw > floor_: raw else: floor_) + 4.0) / 4.0
            fixed[m * 3000 + f] = normed

    MelSpectrogram(3000, n_mels, fixed)
