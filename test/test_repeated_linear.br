# Isolates whether REPEATED linear_gpu calls across many iterations produce
# consistent results at vocab scale.
use io
use math
use math_gpu

let int D      = 384
let int D_OUT  = 51865
let int STEPS  = 30

pub req [float32] mk(int n, float32 scale, float32 bias):
    mut [float32] out = []
    for i in 0..<n:
        out.push((((i * 37 + 11) % 97) as float32 / 97.0) * scale - bias)
    out

def main() throws:
    print "=== repeated linear_gpu calls, checking the big one each time ==="

    let [float32] fc_w = mk(D * (D * 4), 0.1, 0.05)
    let [float32] fc_b = mk(D * 4, 0.05, 0.02)
    let [float32] pr_w = mk((D * 4) * D, 0.1, 0.05)
    let [float32] pr_b = mk(D, 0.05, 0.02)
    let [float32] vocab_w = mk(D * D_OUT, 0.2, 0.1)

    let [float32]'kernel'unified fc_w_g    = upload_floats_gpu(fc_w)
    let [float32]'kernel'unified fc_b_g    = upload_floats_gpu(fc_b)
    let [float32]'kernel'unified pr_w_g    = upload_floats_gpu(pr_w)
    let [float32]'kernel'unified pr_b_g    = upload_floats_gpu(pr_b)
    let [float32]'kernel'unified vocab_w_g = upload_floats_gpu(vocab_w)

    var int step = 0
    var float32 max_diff_ever = 0.0
    while step < STEPS:
        let [float32] x = mk(D, 0.3 + (step as float32) * 0.001, 0.1)

        let [float32]'kernel'unified fc  = linear_gpu(x, fc_w_g, fc_b_g, 1, D, D * 4)
        let [float32]'kernel'unified act = gelu_gpu(fc)
        let [float32] pr                 = linear_gpu(act, pr_w_g, pr_b_g, 1, D * 4, D)

        let [float32] gpu_out = linear_nobias_gpu(pr, vocab_w_g, 1, D, D_OUT)

        var float32 cpu0 = 0.0
        var float32 cpu57 = 0.0
        var float32 cpu25000 = 0.0
        var int i = 0
        while i < D:
            cpu0 += pr[i] * vocab_w[0 * D + i]
            cpu57 += pr[i] * vocab_w[57 * D + i]
            cpu25000 += pr[i] * vocab_w[25000 * D + i]
            i += 1

        let d0 = if cpu0 > gpu_out[0]: cpu0 - gpu_out[0] else: gpu_out[0] - cpu0
        let d57 = if cpu57 > gpu_out[57]: cpu57 - gpu_out[57] else: gpu_out[57] - cpu57
        let d25000 = if cpu25000 > gpu_out[25000]: cpu25000 - gpu_out[25000] else: gpu_out[25000] - cpu25000
        var float32 step_max = d0
        if d57 > step_max: step_max = d57
        if d25000 > step_max: step_max = d25000
        if step_max > max_diff_ever: max_diff_ever = step_max

        print "step {step}: gpu[0]={gpu_out[0]:.4f} cpu[0]={cpu0:.4f}  gpu[57]={gpu_out[57]:.4f} cpu[57]={cpu57:.4f}  gpu[25000]={gpu_out[25000]:.4f} cpu[25000]={cpu25000:.4f}  diff={step_max:.6f}"
        step += 1

    print "max diff across all steps = {max_diff_ever:.8f}"
    guard max_diff_ever < 1e-4 else throw "repeated linear_gpu diverged: {max_diff_ever}"
