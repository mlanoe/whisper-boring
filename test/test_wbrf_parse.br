# test/test_wbrf_parse.br — sanity-checks the WBRF parsing logic in model.br's
# load_whisper() at small scale (a couple of tiny tensors), independent of the
# interpreter's array-size limitation that currently blocks parsing a full
# multi-million-float real model checkpoint.
use io

def main() throws:
    let string path = "test/tiny_test.wbrf"
    let [uint8] bytes = fs.readBytes(path)
    guard bytes.length >= 8 else throw "WBRF file too short: {path}"

    guard int(bytes[0]) == 87 and int(bytes[1]) == 66 and int(bytes[2]) == 82 and int(bytes[3]) == 70 else throw "Not a WBRF file (bad magic): {path}"

    let int n_tensors = read_u32_le(bytes, 4)
    print "n_tensors = {n_tensors}  (expect 2)"

    mut {string=[float]} tensors = {=}
    var int offset = 8
    var int ti = 0

    while ti < n_tensors:
        let int name_len = read_u32_le(bytes, offset)
        offset += 4
        let string name = read_utf8(bytes, offset, name_len)
        offset += name_len
        let int n_elems = read_u32_le(bytes, offset)
        offset += 4

        mut [float] data = []
        var int ei = 0
        while ei < n_elems:
            data.push(read_f32_le(bytes, offset))
            offset += 4
            ei += 1

        tensors[name] = data
        ti += 1

    let [float] foo = tensors["foo.weight"]
    let [float] bar = tensors["bar.bias"]
    print "foo.weight = [{foo[0]}, {foo[1]}, {foo[2]}]  (expect [1.5, 2.5, 3.5])"
    print "bar.bias = [{bar[0]}, {bar[1]}]  (expect [-1, 4.25])"
