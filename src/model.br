# src/model.br — Whisper model: weight loading and transcription pipeline

use audio
use audio_gpu
use encoder
use decoder
use tokenizer
use io
use math
use math_gpu

# Supported model sizes and their hyperparameters.
enum ModelSize:
    Tiny    # d=384, n_head=6,  n_layer=4, n_vocab=51865
    Base    # d=512, n_head=8,  n_layer=6, n_vocab=51865
    Small   # d=768, n_head=12, n_layer=12, n_vocab=51865
    Medium  # d=1024, n_head=16, n_layer=24, n_vocab=51865

struct ModelConfig:
    int n_mels         # 80
    int n_audio_ctx    # 1500 (audio encoder sequence length)
    int n_audio_state  # d_model for encoder
    int n_audio_head
    int n_audio_layer
    int n_vocab        # 51865
    int n_text_ctx     # 448 (max decoder context)
    int n_text_state   # d_model for decoder
    int n_text_head
    int n_text_layer

    type req ModelConfig for_size(ModelSize size):
        match size:
            Tiny:   ModelConfig(n_mels=80, n_audio_ctx=1500, n_audio_state=384,
                        n_audio_head=6,  n_audio_layer=4,  n_vocab=51865,
                        n_text_ctx=448,  n_text_state=384, n_text_head=6,  n_text_layer=4)
            Base:   ModelConfig(n_mels=80, n_audio_ctx=1500, n_audio_state=512,
                        n_audio_head=8,  n_audio_layer=6,  n_vocab=51865,
                        n_text_ctx=448,  n_text_state=512, n_text_head=8,  n_text_layer=6)
            Small:  ModelConfig(n_mels=80, n_audio_ctx=1500, n_audio_state=768,
                        n_audio_head=12, n_audio_layer=12, n_vocab=51865,
                        n_text_ctx=448,  n_text_state=768, n_text_head=12, n_text_layer=12)
            Medium: ModelConfig(n_mels=80, n_audio_ctx=1500, n_audio_state=1024,
                        n_audio_head=16, n_audio_layer=24, n_vocab=51865,
                        n_text_ctx=448,  n_text_state=1024, n_text_head=16, n_text_layer=24)

struct Whisper:
    ModelConfig     config
    AudioEncoder    encoder
    mut TextDecoder decoder
    Tokenizer       tokenizer

    # Full transcription pipeline: audio path → transcript string (100% GPU resident).
    def string transcribe(string audio_path) throws:
        let [float32]        samples   = load_wav(audio_path)
        print "[diag] loaded {samples.length} samples"
        let MelSpectrogram   mel       = log_mel_spectrogram_gpu(samples)
        print "[diag] mel: {mel.n_frames} frames"
        let [float32]'kernel'unified audio = encoder_forward_gpu(self.encoder, mel)
        print "[diag] encoder done"
        let int              seq_a     = mel.n_frames / 2  # halved by conv2 stride=2
        let [int]            ids       = self.decoder.generate(audio, seq_a, 448)
        print "[diag] decoder done: {ids.length} tokens"
        self.tokenizer.decode(ids)

# ── Weight loading ────────────────────────────────────────────────────────────
#
# Weights are stored in a simple flat binary format (see docs/weight-format.md):
#   4 bytes: magic 0x57425246 ("WBRF")
#   4 bytes: number of tensors (LE u32)
#   for each tensor:
#     4 bytes: name length (LE u32)
#     N bytes: name (UTF-8)
#     4 bytes: number of elements (LE u32)
#     4 × elements bytes: float32 values (LE, row-major)

pub [float32] get_tensor({string=[float32]} tensors, string key) throws:
    guard tensors.contains(key) else throw "missing tensor: {key}"
    tensors[key]

pub [float32] checked_transpose([float32] src, int rows, int cols, string name) throws:
    guard src.length == rows * cols else throw "tensor '{name}' has {src.length} elements, expected {rows * cols} ({rows}x{cols})"
    transpose_flat(src, rows, cols)

# Validate tensor size and upload once to a GPU-resident buffer.
req [float32]'kernel'unified upload_tensor({string=[float32]} tensors, string key, int expected_len) throws:
    let [float32] src = get_tensor(tensors, key)
    guard src.length == expected_len else throw "tensor '{key}' has {src.length} elements, expected {expected_len}"
    upload_floats_gpu(src)

# Parse a WBRF binary blob into its {name -> flat float32 data} tensor map.
pub {string=[float32]} parse_wbrf_tensors([uint8] bytes) throws:
    guard bytes.length >= 8 else throw "WBRF file too short"

    # Magic: "WBRF" = 0x57 0x42 0x52 0x46
    guard int(bytes[0]) == 87 and int(bytes[1]) == 66 and int(bytes[2]) == 82 and int(bytes[3]) == 70 else throw "Not a WBRF file (bad magic)"

    let int n_tensors = read_u32_le(bytes, 4)
    mut {string=[float32]} tensors = {=}
    var int offset = 8
    var int ti = 0

    while ti < n_tensors:
        guard offset + 4 <= bytes.length else throw "WBRF truncated: missing name_len for tensor {ti} of {n_tensors}"
        let int name_len = read_u32_le(bytes, offset)
        offset += 4
        guard offset + name_len <= bytes.length else throw "WBRF truncated: name for tensor {ti} runs past end of file"
        let string name = read_utf8(bytes, offset, name_len)
        offset += name_len
        guard offset + 4 <= bytes.length else throw "WBRF truncated: missing n_elems for tensor '{name}'"
        let int n_elems = read_u32_le(bytes, offset)
        offset += 4
        guard offset + 4 * n_elems <= bytes.length else throw "WBRF truncated: tensor '{name}' expects {n_elems} floats but file ends early"

        mut [float32] values = [0.0 as float32 for ..<n_elems]
        var int ei = 0
        while ei < n_elems:
            values[ei] = read_f32_le(bytes, offset)
            offset += 4
            ei += 1

        tensors[name] = values
        ti += 1

    tensors

pub Whisper load_whisper(string weights_path, string tokenizer_dir,
                         ModelSize size) throws:
    let ModelConfig cfg = ModelConfig.for_size(size)

    # ── Parse WBRF binary ─────────────────────────────────────────────────────
    let [uint8] bytes = fs.readBytes(weights_path)
    guard bytes.length >= 8 else throw "WBRF file too short: {weights_path}"

    mut {string=[float32]} tensors = parse_wbrf_tensors(bytes)

    # ── Build AudioEncoder (weights uploaded once to GPU in native layout) ────
    let int ad = cfg.n_audio_state
    mut [EncoderBlock] enc_blocks = []
    var int li = 0
    while li < cfg.n_audio_layer:
        let string ep = "encoder.blocks.{li}"
        enc_blocks.push(EncoderBlock(
            attn_q_w = upload_tensor(tensors, "{ep}.attn_q.weight", ad * ad),
            attn_q_b = upload_tensor(tensors, "{ep}.attn_q.bias",   ad),
            attn_k_w = upload_tensor(tensors, "{ep}.attn_k.weight", ad * ad),
            attn_v_w = upload_tensor(tensors, "{ep}.attn_v.weight", ad * ad),
            attn_v_b = upload_tensor(tensors, "{ep}.attn_v.bias",   ad),
            attn_o_w = upload_tensor(tensors, "{ep}.attn_o.weight", ad * ad),
            attn_o_b = upload_tensor(tensors, "{ep}.attn_o.bias",   ad),
            ln1_w    = upload_tensor(tensors, "{ep}.ln1.weight",    ad),
            ln1_b    = upload_tensor(tensors, "{ep}.ln1.bias",      ad),
            ln2_w    = upload_tensor(tensors, "{ep}.ln2.weight",    ad),
            ln2_b    = upload_tensor(tensors, "{ep}.ln2.bias",      ad),
            mlp_fc_w = upload_tensor(tensors, "{ep}.mlp_fc.weight", ad * 4 * ad),
            mlp_fc_b = upload_tensor(tensors, "{ep}.mlp_fc.bias",   ad * 4),
            mlp_pr_w = upload_tensor(tensors, "{ep}.mlp_pr.weight", ad * ad * 4),
            mlp_pr_b = upload_tensor(tensors, "{ep}.mlp_pr.bias",   ad)
        ))
        li += 1

    let AudioEncoder enc = AudioEncoder(
        conv1_w    = upload_tensor(tensors, "encoder.conv1.weight", ad * cfg.n_mels * 3),
        conv1_b    = upload_tensor(tensors, "encoder.conv1.bias",   ad),
        conv2_w    = upload_tensor(tensors, "encoder.conv2.weight", ad * ad * 3),
        conv2_b    = upload_tensor(tensors, "encoder.conv2.bias",   ad),
        pos_emb    = upload_tensor(tensors, "encoder.pos_emb",      cfg.n_audio_ctx * ad),
        blocks     = enc_blocks,
        ln_w       = upload_tensor(tensors, "encoder.ln.weight",    ad),
        ln_b       = upload_tensor(tensors, "encoder.ln.bias",      ad),
        n_head_val = cfg.n_audio_head
    )

    # ── Build TextDecoder (no tok_emb_t duplicate; native kernel.tensors.linear)
    let int td = cfg.n_text_state
    mut [DecoderBlock] dec_blocks = []
    li = 0
    while li < cfg.n_text_layer:
        let string dp = "decoder.blocks.{li}"
        dec_blocks.push(DecoderBlock(
            sa_q_w     = upload_tensor(tensors, "{dp}.sa_q.weight",   td * td),
            sa_q_b     = upload_tensor(tensors, "{dp}.sa_q.bias",     td),
            sa_k_w     = upload_tensor(tensors, "{dp}.sa_k.weight",   td * td),
            sa_v_w     = upload_tensor(tensors, "{dp}.sa_v.weight",   td * td),
            sa_v_b     = upload_tensor(tensors, "{dp}.sa_v.bias",     td),
            sa_o_w     = upload_tensor(tensors, "{dp}.sa_o.weight",   td * td),
            sa_o_b     = upload_tensor(tensors, "{dp}.sa_o.bias",     td),
            ln1_w      = upload_tensor(tensors, "{dp}.ln1.weight",    td),
            ln1_b      = upload_tensor(tensors, "{dp}.ln1.bias",      td),
            ca_q_w     = upload_tensor(tensors, "{dp}.ca_q.weight",   td * td),
            ca_q_b     = upload_tensor(tensors, "{dp}.ca_q.bias",     td),
            ca_k_w     = upload_tensor(tensors, "{dp}.ca_k.weight",   td * td),
            ca_v_w     = upload_tensor(tensors, "{dp}.ca_v.weight",   td * td),
            ca_v_b     = upload_tensor(tensors, "{dp}.ca_v.bias",     td),
            ca_o_w     = upload_tensor(tensors, "{dp}.ca_o.weight",   td * td),
            ca_o_b     = upload_tensor(tensors, "{dp}.ca_o.bias",     td),
            ln2_w      = upload_tensor(tensors, "{dp}.ln2.weight",    td),
            ln2_b      = upload_tensor(tensors, "{dp}.ln2.bias",      td),
            mlp_fc_w   = upload_tensor(tensors, "{dp}.mlp_fc.weight", td * 4 * td),
            mlp_fc_b   = upload_tensor(tensors, "{dp}.mlp_fc.bias",   td * 4),
            mlp_pr_w   = upload_tensor(tensors, "{dp}.mlp_pr.weight", td * td * 4),
            mlp_pr_b   = upload_tensor(tensors, "{dp}.mlp_pr.bias",   td),
            ln3_w      = upload_tensor(tensors, "{dp}.ln3.weight",    td),
            ln3_b      = upload_tensor(tensors, "{dp}.ln3.bias",      td),
            cache_sa_k = [],
            cache_sa_v = [],
            cache_ca_k = [],
            cache_ca_v = [],
            ca_cached  = false
        ))
        li += 1

    let TextDecoder dec = TextDecoder(
        tok_emb    = upload_tensor(tensors, "decoder.tok_emb", cfg.n_vocab * td),
        pos_emb    = upload_tensor(tensors, "decoder.pos_emb", cfg.n_text_ctx * td),
        blocks     = dec_blocks,
        ln_w       = upload_tensor(tensors, "decoder.ln.weight", td),
        ln_b       = upload_tensor(tensors, "decoder.ln.bias",   td),
        n_head_val = cfg.n_text_head
    )

    let Tokenizer tok = load_tokenizer(tokenizer_dir)
    Whisper(cfg, enc, dec, tok)
