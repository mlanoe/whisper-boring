# Checks whether tok_emb (n_vocab x d, weight-tied embedding/output-projection
# matrix) is fully populated after loading the real WBRF weights, or whether
# only certain rows got loaded correctly (rows far from index 0 reading back
# as all-zero would explain the decoder's degenerate logits).
use model

def main() throws:
    var Whisper w = load_whisper("weights/tiny.wbrf", "weights/tokenizer", ModelSize.Tiny)
    print "[diag] loaded"

    let int d = w.decoder.d()
    let int n_vocab = w.decoder.n_vocab()
    print "[diag] d={d} n_vocab={n_vocab} tok_emb.length={w.decoder.tok_emb.length}"

    let [int] rows = [0, 57, 300, 1000, 25000, 49999, 50257, 51000, 51864]
    for r in rows:
        var float acc = 0.0
        var int j = 0
        while j < d:
            let v = w.decoder.tok_emb[r * d + j]
            acc += (if v < 0.0: 0.0 - v else: v)
            j += 1
        print "row {r}: sum|.| = {acc:.6f}  first3 = [{w.decoder.tok_emb[r*d]:.6f}, {w.decoder.tok_emb[r*d+1]:.6f}, {w.decoder.tok_emb[r*d+2]:.6f}]"
