# test/test_mel_gpu.br — vérifie que log_mel_spectrogram_gpu produit
# des résultats cohérents avec la version CPU (audio_gpu.br, simulation).
use io
use math
use audio
use audio_gpu

def main() throws:
    print "=== GPU mel spectrogram (simulation) ==="

    let [float32] samples = load_wav("test/tiny.wav")
    print "Audio: {samples.length} samples"

    print "Computing CPU STFT power..."
    let int n_freq_cpu    = 201
    let [float32] power_cpu = stft_power(samples, 400, 160)
    let int n_frames_cpu  = power_cpu.length / n_freq_cpu
    print "CPU STFT: {n_frames_cpu} frames × {n_freq_cpu} bins"
    let float32 p_cpu_0 = power_cpu[0]
    print "CPU power[0] = {p_cpu_0:.4f}"

    print "Computing GPU STFT power (simulated)..."
    let int n_audio  = samples.length
    let int pad      = 200
    mut [float32] padded = []
    for i in 0..<pad:
        let int src = pad - i
        padded.push(if src < n_audio: samples[src] else: (0.0 as float32))
    for v in samples: padded.push(v)
    for i in 0..<pad:
        let int src = n_audio - 2 - i
        padded.push(if src >= 0 and src < n_audio: samples[src] else: (0.0 as float32))

    let int n_padded = padded.length
    let int n_frames = (n_padded - 400) / 160
    let int n_freq   = 201
    print "GPU STFT: {n_frames} frames × {n_freq} bins (expected)"

    let [float32] win = hann_window(400)

    let int stft_blocks = (n_frames + 255) / 256
    mut k_stft = StftPower(padded, win, n_frames, 160, n_padded, 400, n_freq)
    kernel:
        k_stft(block = 256, grid = stft_blocks)

    let float32 p_gpu_0 = k_stft.power[0]
    print "GPU power[0] = {p_gpu_0:.4f}"

    let float32 diff = if p_cpu_0 > p_gpu_0: p_cpu_0 - p_gpu_0 else: p_gpu_0 - p_cpu_0
    print "Diff CPU-GPU bin 0: {diff:.6f}  (expect ≈ 0)"

    print "GPU mel filterbank..."
    let [float32] fb   = mel_filterbank(80, 400, 16000)
    let int mel_blocks = (n_frames + 255) / 256
    mut k_mel = MelApply(fb, k_stft.power, 80, n_frames, n_freq)
    kernel:
        k_mel(block = 256, grid = mel_blocks)

    let float32 mel0 = k_mel.mel[0]
    print "GPU mel[0] = {mel0:.4f}"
    print "GPU mel shape: {80} × {n_frames} = {k_mel.mel.length}"

    print "Verifying log_mel_spectrogram_gpu_resident..."
    let MelSpectrogram mel_ref = log_mel_spectrogram_gpu(samples)
    let ([float32] mel_res, int res_frames, int res_mels) = log_mel_spectrogram_gpu_resident(samples)
    guard res_frames == 3000 and res_mels == 80 else throw "resident mel shape mismatch"
    var float32 max_res_diff = 0.0
    for f in 0..<res_frames:
        for m in 0..<res_mels:
            let float32 a = mel_ref.data[m * 3000 + f]
            let float32 b = mel_res[f * 80 + m]
            let float32 d = if a > b: a - b else: b - a
            if d > max_res_diff: max_res_diff = d
    print "log_mel_spectrogram_gpu_resident max diff = {max_res_diff:.8f} (expect 0)"
    guard max_res_diff < 1e-6 else throw "resident mel diverged from reference!"

    print "=== GPU test passed ==="
