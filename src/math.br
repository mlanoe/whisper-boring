# src/math.br — linear algebra primitives (float32)

pub let float32 PI = 3.141592653589793

# ── Utilities ────────────────────────────────────────────────────────────────

pub req [float32] zeros(int n):
    [0.0 as float32 for ..<n]

pub req [float32] vec_add([float32] a, [float32] b):
    mut [float32] out = []
    for i in 0..<a.length:
        out.push(a[i] + b[i])
    out

pub req [float32] vec_scale([float32] a, float32 s):
    a |> map((v): v * s)

# Flat-matrix transpose: src is (rows × cols) row-major, returns (cols × rows).
pub req [float32] transpose_flat([float32] src, int rows, int cols):
    mut [float32] dst = [0.0 as float32 for ..<rows * cols]
    for i in 0..<rows:
        for j in 0..<cols:
            dst[j * rows + i] = src[i * cols + j]
    dst

# ── Complex numbers (for FFT) ────────────────────────────────────────────────

pub struct Complex:
    float32 re
    float32 im

    req Complex add(Complex b):
        Complex(re=self.re + b.re, im=self.im + b.im)

    req Complex sub(Complex b):
        Complex(re=self.re - b.re, im=self.im - b.im)

    req Complex mul(Complex b):
        Complex(
            re = self.re * b.re - self.im * b.im,
            im = self.re * b.im + self.im * b.re
        )

    req float32 mag():
        (self.re * self.re + self.im * self.im).sqrt()

pub int next_pow2(int n):
    var int p = 1
    while p < n: p *= 2
    p

pub int ilog2(int n):
    var int k = 0
    var int m = n
    while m > 1:
        m /= 2
        k += 1
    k

# Precompute one-period cos/sin twiddle tables for direct DFT of size n_fft.
pub req ([float32], [float32]) dft_tables(int n_fft):
    mut [float32] cos_tab = []
    mut [float32] sin_tab = []
    for i in 0..<n_fft:
        let float32 ang = -2.0 * PI * (i as float32) / (n_fft as float32)
        cos_tab.push(ang.cos())
        sin_tab.push(ang.sin())
    (cos_tab, sin_tab)

# Windowed STFT frame → magnitude spectrum using precomputed twiddle tables.
pub req [float32] rfft_windowed_with_tables([float32] audio, int start, [float32] win,
                                            [float32] cos_tab, [float32] sin_tab, int n_fft) throws:
    mut [float32] x = []
    for i in 0..<n_fft:
        let float32 sample = if start + i < audio.length: audio[start + i] else: (0.0 as float32)
        x.push(sample * win[i])

    let int n_out = n_fft / 2 + 1
    mut [float32] mag = []
    for k in 0..<n_out:
        var float32 re = 0.0
        var float32 im = 0.0
        for i in 0..<n_fft:
            let int idx = (k * i) % n_fft
            re += x[i] * cos_tab[idx]
            im += x[i] * sin_tab[idx]
        mag.push((re * re + im * im).sqrt())
    mag

# Windowed STFT frame → magnitude spectrum.
pub req [float32] rfft_windowed([float32] audio, int start, [float32] win, int n_fft) throws:
    let ([float32] cos_tab, [float32] sin_tab) = dft_tables(n_fft)
    rfft_windowed_with_tables(audio, start, win, cos_tab, sin_tab, n_fft)

# Convenience wrapper: takes a samples slice directly (unit window).
pub req [float32] rfft_flat([float32] samples, int n_fft) throws:
    let [float32] unit_win = [1.0 as float32 for ..<n_fft]
    rfft_windowed(samples, 0, unit_win, n_fft)

# ── Activation functions ─────────────────────────────────────────────────────

pub req float32 gelu_f(float32 x):
    0.5 * x * (1.0 + (0.7978845608 * (x + 0.044715 * x * x * x)).tanh())

pub req [float32] gelu([float32] x):
    x |> map((v): gelu_f(v))

# ── Normalization ────────────────────────────────────────────────────────────

pub req [float32] softmax([float32] x):
    var float32 mx = x[0]
    for v in x:
        if v > mx: mx = v
    mut [float32] e = x |> map((v): (v - mx).exp())
    let float32   s = e |> sum()
    e |> map((v): v / s)

# Normalize a single vector of length d.
pub req [float32] layer_norm([float32] x, [float32] w, [float32] b):
    let int n      = x.length
    let float32 mu = (x |> sum()) / (n as float32)
    var float32 v  = 0.0
    for xi in x: v += (xi - mu) * (xi - mu)
    v /= (n as float32)
    let float32 sd = (v + 1e-5).sqrt()
    mut [float32] out = []
    for i in 0..<n:
        out.push(w[i] * (x[i] - mu) / sd + b[i])
    out

# Apply layer_norm to every row of a (seq × d) matrix.
pub req [float32] layer_norm_seq([float32] x, [float32] w, [float32] b, int seq, int d):
    mut [float32] out = []
    for i in 0..<seq:
        let [float32] row    = x[(i * d)..<((i + 1) * d)]
        let [float32] normed = layer_norm(row, w, b)
        for v in normed: out.push(v)
    out

# ── Matrix operations ────────────────────────────────────────────────────────

# A (m×k) · B (k×n) → C (m×n), all row-major flat.
pub req [float32] matmul([float32] a, [float32] b, int m, int k, int n):
    mut [float32] c = []
    for i in 0..<m:
        for j in 0..<n:
            var float32 s = 0.0
            for p in 0..<k:
                s += a[i * k + p] * b[p * n + j]
            c.push(s)
    c

# A (m×k) · B^T (n×k) → C (m×n).
pub req [float32] matmul_bt([float32] a, [float32] b, int m, int k, int n):
    mut [float32] c = []
    for i in 0..<m:
        for j in 0..<n:
            var float32 s = 0.0
            for p in 0..<k:
                s += a[i * k + p] * b[j * k + p]
            c.push(s)
    c

# Linear layer: y = x W^T + b.
# x: (seq × d_in), W: (d_out × d_in), b: (d_out,) → y: (seq × d_out).
pub req [float32] linear([float32] x, [float32] w, [float32] bv, int seq, int d_in, int d_out):
    mut [float32] out = []
    for i in 0..<seq:
        for j in 0..<d_out:
            var float32 s = bv[j]
            for p in 0..<d_in:
                s += x[i * d_in + p] * w[j * d_in + p]
            out.push(s)
    out

# Conv1d with same-padding and stride 1.
# x: (T × C_in), w: (C_out × C_in × K), b: (C_out,) → out: (T × C_out).
pub req [float32] conv1d([float32] x, [float32] w, [float32] bv,
                   int t, int c_in, int c_out, int k):
    let int pad = k / 2
    mut [float32] out = []
    for i in 0..<t:
        for oc in 0..<c_out:
            var float32 s = bv[oc]
            for ic in 0..<c_in:
                for ki in 0..<k:
                    let int src = i + ki - pad
                    if src >= 0 and src < t:
                        s += x[src * c_in + ic] * w[oc * c_in * k + ic * k + ki]
            out.push(s)
    out

# ── Attention ────────────────────────────────────────────────────────────────

# Scaled dot-product attention.
# q: (seq_q × d_k), k: (seq_k × d_k), v: (seq_k × d_v) → (seq_q × d_v).
# Pass causal=true to apply a causal (upper-triangular) mask.
pub req [float32] attention([float32] q, [float32] k, [float32] v,
                      int seq_q, int seq_k, int d_k, int d_v,
                      bool causal):
    let float32 scale = (d_k as float32).sqrt()
    mut [float32] scores = matmul_bt(q, k, seq_q, d_k, seq_k)

    for i in 0..<seq_q:
        for j in 0..<seq_k:
            var float32 s = scores[i * seq_k + j] / scale
            if causal and j > i: s = -1e9
            scores[i * seq_k + j] = s

    mut [float32] weights = []
    for i in 0..<seq_q:
        let [float32] row = scores[(i * seq_k)..<((i + 1) * seq_k)]
        let [float32] p   = softmax(row)
        for w2 in p: weights.push(w2)

    matmul(weights, v, seq_q, seq_k, d_v)

# Multi-head attention.
# x_q:  (seq_q × d), x_kv: (seq_k × d)
# w_{q,k,v}: (d × d), b_{q,k,v}: (d,)
# w_o: (d × d), b_o: (d,)
pub req [float32] mha([float32] x_q,  [float32] x_kv,
                [float32] w_q,  [float32] b_q,
                [float32] w_k,  [float32] b_k,
                [float32] w_v,  [float32] b_v,
                [float32] w_o,  [float32] b_o,
                int seq_q, int seq_k, int d, int n_head,
                bool causal):
    let int d_head = d / n_head

    let [float32] Q = linear(x_q,  w_q, b_q, seq_q, d, d)
    let [float32] K = linear(x_kv, w_k, b_k, seq_k, d, d)
    let [float32] V = linear(x_kv, w_v, b_v, seq_k, d, d)

    mut [float32] concat = zeros(seq_q * d)

    for h in 0..<n_head:
        let int off = h * d_head

        mut [float32] Qh = []
        mut [float32] Kh = []
        mut [float32] Vh = []
        for i in 0..<seq_q:
            for j in 0..<d_head:
                Qh.push(Q[i * d + off + j])
        for i in 0..<seq_k:
            for j in 0..<d_head:
                Kh.push(K[i * d + off + j])
                Vh.push(V[i * d + off + j])

        let [float32] head = attention(Qh, Kh, Vh, seq_q, seq_k, d_head, d_head, causal)

        for i in 0..<seq_q:
            for j in 0..<d_head:
                concat[i * d + off + j] = head[i * d_head + j]

    linear(concat, w_o, b_o, seq_q, d, d)
