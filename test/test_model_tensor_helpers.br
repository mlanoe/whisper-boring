# test/test_model_tensor_helpers.br — unit tests for model.br's get_tensor
# and checked_transpose helpers (bug: missing/mis-sized tensors used to
# panic deep in a dict index or transpose_flat instead of throwing).
use model

def main() throws:
    var {string=[float]} tensors = {=}
    tensors["a.weight"] = [1.0, 2.0, 3.0, 4.0]

    # ── get_tensor ────────────────────────────────────────────────────────
    let ok = get_tensor(tensors, "a.weight")
    print "get_tensor ok: {ok.length} elems  (expect 4)"

    try:
        let missing = get_tensor(tensors, "b.weight")
        print "FAIL: expected a throw, got {missing.length} elems"
    catch:
        print "get_tensor missing: caught expected error: {error}"

    # ── checked_transpose ─────────────────────────────────────────────────
    let t_ok = checked_transpose(ok, 2, 2, "a.weight")
    print "checked_transpose ok: {t_ok.length} elems  (expect 4)"

    try:
        let t_bad = checked_transpose(ok, 3, 3, "a.weight")
        print "FAIL: expected a throw, got {t_bad.length} elems"
    catch:
        print "checked_transpose mismatch: caught expected error: {error}"

    print "Model tensor helpers test passed."
