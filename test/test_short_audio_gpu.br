# test/test_short_audio_gpu.br — GPU-path mirror of test_short_audio.br:
# log_mel_spectrogram_gpu must throw on too-short audio instead of indexing
# an empty mel_log array (same bug as audio.br, fixed in audio_gpu.br).
use audio_gpu

def main() throws:
    var [float] short_audio = []
    for _ in 0..10:
        short_audio.push(0.0)

    try:
        let m = log_mel_spectrogram_gpu(short_audio)
        print "FAIL: expected a throw, got {m.n_frames} frames"
    catch:
        print "short_audio (gpu): caught expected error: {error}"

    print "Short audio GPU test passed."
