# The encoder was already proven bit-identical across runs. This isolates
# whether the DECODER path (KV-cache, many small sequential kernel dispatches
# over up to 448 greedy steps) is what's nondeterministic: compute the real
# encoder output ONCE, then decode it 3 times with FRESH decoder instances
# (each freshly loaded -> clean KV-cache) and compare token sequences + logits.
use model

def main() throws:
    var Whisper w1 = load_whisper("weights/tiny.wbrf", "weights/tokenizer", ModelSize.Tiny)
    print "[diag] w1 loaded"
    let [float] samples = load_wav("test/test10s.wav")
    let MelSpectrogram mel = log_mel_spectrogram(samples)
    let int seq_a = mel.n_frames / 2
    let [float] audio = w1.encoder.forward(mel)
    print "[diag] encoder done, audio.length={audio.length} seq_a={seq_a}"

    let [int] ids1 = w1.decoder.generate(audio.clone(), seq_a, 20)
    print "[diag] decode 1: {ids1.length} tokens = {ids1}"

    var Whisper w2 = load_whisper("weights/tiny.wbrf", "weights/tokenizer", ModelSize.Tiny)
    print "[diag] w2 loaded"
    let [int] ids2 = w2.decoder.generate(audio.clone(), seq_a, 20)
    print "[diag] decode 2: {ids2.length} tokens = {ids2}"

    var Whisper w3 = load_whisper("weights/tiny.wbrf", "weights/tokenizer", ModelSize.Tiny)
    print "[diag] w3 loaded"
    let [int] ids3 = w3.decoder.generate(audio.clone(), seq_a, 20)
    print "[diag] decode 3: {ids3.length} tokens = {ids3}"

    print "=== summary ==="
    print "decode1 == decode2: {ids1 == ids2}"
    print "decode2 == decode3: {ids2 == ids3}"
