# test/test_math_gpu.br — vérifie que math_gpu.br produit des résultats
# cohérents avec les fonctions CPU de référence (math.br), en simulation.
use io
use math
use math_gpu

def main() throws:
    print "=== GPU transformer math (simulation) ==="

    # ── linear ────────────────────────────────────────────────────────────
    let int seq    = 5
    let int d_in   = 4
    let int d_out  = 3
    mut [float32] x = []
    for i in 0..<(seq * d_in):
        x.push((i as float32) * 0.1)
    mut [float32] w = []
    for i in 0..<(d_out * d_in):
        w.push((i as float32) * 0.05 - 0.2)
    mut [float32] bv = []
    for i in 0..<d_out:
        bv.push((i as float32) * 0.01)

    let [float32] lin_cpu = linear(x, w, bv, seq, d_in, d_out)
    let [float32] lin_gpu = linear_gpu(x, w, bv, seq, d_in, d_out)
    var float32 max_diff = 0.0
    for i in 0..<lin_cpu.length:
        let d = if lin_cpu[i] > lin_gpu[i]: lin_cpu[i] - lin_gpu[i] else: lin_gpu[i] - lin_cpu[i]
        if d > max_diff: max_diff = d
    print "linear: max |cpu-gpu| = {max_diff:.8f}  (expect ~0)"

    # ── gelu ──────────────────────────────────────────────────────────────
    let [float32] gelu_cpu_v = gelu(lin_cpu)
    let [float32] gelu_gpu_v = gelu_gpu(lin_gpu)
    var float32 gelu_diff = 0.0
    for i in 0..<gelu_cpu_v.length:
        let d = if gelu_cpu_v[i] > gelu_gpu_v[i]: gelu_cpu_v[i] - gelu_gpu_v[i] else: gelu_gpu_v[i] - gelu_cpu_v[i]
        if d > gelu_diff: gelu_diff = d
    print "gelu: max |cpu-gpu| = {gelu_diff:.8f}  (expect ~0)"

    # ── layer_norm_seq ────────────────────────────────────────────────────
    mut [float32] ln_w = []
    mut [float32] ln_b = []
    for i in 0..<d_in:
        ln_w.push(1.0 + (i as float32) * 0.1)
        ln_b.push((i as float32) * 0.02)
    let [float32] ln_cpu = layer_norm_seq(x, ln_w, ln_b, seq, d_in)
    let [float32] ln_gpu = layer_norm_seq_gpu(x, ln_w, ln_b, seq, d_in)
    var float32 ln_diff = 0.0
    for i in 0..<ln_cpu.length:
        let d = if ln_cpu[i] > ln_gpu[i]: ln_cpu[i] - ln_gpu[i] else: ln_gpu[i] - ln_cpu[i]
        if d > ln_diff: ln_diff = d
    print "layer_norm_seq: max |cpu-gpu| = {ln_diff:.8f}  (expect ~0)"

    # ── attention_heads_gpu (single head, n_head=1) ───────────────────────
    let int seq_q = 4
    let int seq_k = 6
    let int d_k   = 3
    let int d_v   = 3
    mut [float32] q = []
    for i in 0..<(seq_q * d_k):
        q.push((i as float32) * 0.03 - 0.5)
    mut [float32] k = []
    for i in 0..<(seq_k * d_k):
        k.push((i as float32) * 0.02 - 0.3)
    mut [float32] v = []
    for i in 0..<(seq_k * d_v):
        v.push((i as float32) * 0.01)

    let [float32] attn_cpu = attention(q, k, v, seq_q, seq_k, d_k, d_v, false)
    let [float32] attn_gpu = attention_heads_gpu(q, k, v, seq_q, seq_k, d_k, 1, false)
    var float32 attn_diff = 0.0
    for i in 0..<attn_cpu.length:
        let d = if attn_cpu[i] > attn_gpu[i]: attn_cpu[i] - attn_gpu[i] else: attn_gpu[i] - attn_cpu[i]
        if d > attn_diff: attn_diff = d
    print "attention_heads_gpu (single head, non-causal): max |cpu-gpu| = {attn_diff:.8f}  (expect ~0)"

    # ── attention_heads_gpu (single head, causal) ─────────────────────────
    let [float32] attn_c_cpu = attention(q, k, v, seq_q, seq_k, d_k, d_v, true)
    let [float32] attn_c_gpu = attention_heads_gpu(q, k, v, seq_q, seq_k, d_k, 1, true)
    var float32 attn_c_diff = 0.0
    for i in 0..<attn_c_cpu.length:
        let d = if attn_c_cpu[i] > attn_c_gpu[i]: attn_c_cpu[i] - attn_c_gpu[i] else: attn_c_gpu[i] - attn_c_cpu[i]
        if d > attn_c_diff: attn_c_diff = d
    print "attention_heads_gpu (single head, causal): max |cpu-gpu| = {attn_c_diff:.8f}  (expect ~0)"

    # ── attention_heads_gpu (multi-head, batched) ─────────────────────────
    let int n_head_attn = 3
    let int d_full      = d_k * n_head_attn
    mut [float32] qm = []
    for i in 0..<(seq_q * d_full):
        qm.push((i as float32) * 0.017 - 0.4)
    mut [float32] km = []
    for i in 0..<(seq_k * d_full):
        km.push((i as float32) * 0.013 - 0.25)
    mut [float32] vm = []
    for i in 0..<(seq_k * d_full):
        vm.push((i as float32) * 0.009 - 0.1)

    mut [float32] concat_ref = zeros(seq_q * d_full)
    for h in 0..<n_head_attn:
        let int off = h * d_k
        mut [float32] qh = []
        mut [float32] kh = []
        mut [float32] vh = []
        for i in 0..<seq_q:
            for j in 0..<d_k:
                qh.push(qm[i * d_full + off + j])
        for i in 0..<seq_k:
            for j in 0..<d_k:
                kh.push(km[i * d_full + off + j])
                vh.push(vm[i * d_full + off + j])
        let [float32] head_ref = attention(qh, kh, vh, seq_q, seq_k, d_k, d_k, true)
        for i in 0..<seq_q:
            for j in 0..<d_k:
                concat_ref[i * d_full + off + j] = head_ref[i * d_k + j]

    let [float32] concat_gpu = attention_heads_gpu(qm, km, vm, seq_q, seq_k, d_full, n_head_attn, true)
    var float32 heads_diff = 0.0
    for i in 0..<concat_ref.length:
        let dd = if concat_ref[i] > concat_gpu[i]: concat_ref[i] - concat_gpu[i] else: concat_gpu[i] - concat_ref[i]
        if dd > heads_diff: heads_diff = dd
    print "attention_heads_gpu (multi-head batched vs per-head CPU reference): max diff = {heads_diff:.8f}  (expect ~0)"

    # ── FlashAttention & FlashDecode (d_head=64, n_head=2) ────────────────
    let int d64   = 128
    let int nh64  = 2
    let int sq64  = 4
    let int sk64  = 6
    mut [float32] q64 = []
    for i in 0..<(sq64 * d64):
        q64.push((((i * 37 + 11) % 97) as float32 / 97.0) * 0.4 - 0.2)
    mut [float32] k64 = []
    for i in 0..<(sk64 * d64):
        k64.push((((i * 53 + 7) % 97) as float32 / 97.0) * 0.4 - 0.2)
    mut [float32] v64 = []
    for i in 0..<(sk64 * d64):
        v64.push((((i * 29 + 19) % 97) as float32 / 97.0) * 0.4 - 0.2)

    let [float32] flash_out = attention_heads_gpu(q64, k64, v64, sq64, sk64, d64, nh64, false)
    let [float32] three_out = attention_three_kernel_gpu(q64, k64, v64, sq64, sk64, d64, nh64, false)
    var float32 flash_diff = 0.0
    for i in 0..<flash_out.length:
        let dd = if flash_out[i] > three_out[i]: flash_out[i] - three_out[i] else: three_out[i] - flash_out[i]
        if dd > flash_diff: flash_diff = dd
    print "FlashAttention (d_head=64, seq_q=4): max diff = {flash_diff:.8f}  (expect ~0)"

    let [float32] q64_row0 = q64[0..<d64]
    let [float32] dec_out  = attention_heads_gpu(q64_row0, k64, v64, 1, sk64, d64, nh64, false)
    var float32 dec_diff = 0.0
    for i in 0..<d64:
        let dd = if dec_out[i] > three_out[i]: dec_out[i] - three_out[i] else: three_out[i] - dec_out[i]
        if dd > dec_diff: dec_diff = dd
    print "FlashDecode (d_head=64, seq_q=1): max diff = {dec_diff:.8f}  (expect ~0)"

    # ── mha ───────────────────────────────────────────────────────────────
    let int d      = 8
    let int n_head = 2
    mut [float32] xq = []
    for i in 0..<(seq_q * d):
        xq.push((i as float32) * 0.02 - 0.4)
    mut [float32] wq = []
    mut [float32] wk = []
    mut [float32] wv = []
    mut [float32] wo = []
    for i in 0..<(d * d):
        wq.push((i as float32) * 0.01 - 0.05)
        wk.push((i as float32) * 0.008 - 0.04)
        wv.push((i as float32) * 0.006 - 0.03)
        wo.push((i as float32) * 0.004 - 0.02)
    let [float32] bq = zeros(d)
    let [float32] bo = zeros(d)
    mut [float32] bv2 = []
    for i in 0..<d:
        bv2.push((i as float32) * 0.001)

    let [float32] mha_cpu_v = mha(xq, xq, wq, bq, wk, zeros(d), wv, bv2, wo, bo, seq_q, seq_q, d, n_head, true)
    let [float32] mha_gpu_v = mha_gpu(xq, xq, wq, bq, wk, zeros(d), wv, bv2, wo, bo, seq_q, seq_q, d, n_head, true)
    var float32 mha_diff = 0.0
    for i in 0..<mha_cpu_v.length:
        let dd = if mha_cpu_v[i] > mha_gpu_v[i]: mha_cpu_v[i] - mha_gpu_v[i] else: mha_gpu_v[i] - mha_cpu_v[i]
        if dd > mha_diff: mha_diff = dd
    print "mha (causal): max |cpu-gpu| = {mha_diff:.8f}  (expect ~0)"

    # ── mha_step_gpu / mha_cross_step_gpu (KV-cache) ──────────────────────
    var float32 step_diff = 0.0
    var [float32]'kernel'unified step_cache_k = []
    var [float32]'kernel'unified step_cache_v = []
    for i in 0..<seq_q:
        let [float32] x_i = xq[(i * d)..<((i + 1) * d)]
        let ([float32] step_out, [float32]'kernel'unified new_k, [float32]'kernel'unified new_v) = mha_step_gpu(
            x_i, wq, bq, wk, zeros(d), wv, bv2, wo, bo,
            step_cache_k, step_cache_v, d, n_head)
        step_cache_k = new_k
        step_cache_v = new_v
        for j in 0..<d:
            let expected = mha_gpu_v[i * d + j]
            let dd = if expected > step_out[j]: expected - step_out[j] else: step_out[j] - expected
            if dd > step_diff: step_diff = dd
    print "mha_step_gpu (vs causal mha_gpu, per-position): max diff = {step_diff:.8f}  (expect ~0)"

    # ── mha_cross_step_gpu (fixed KV cache) ───────────────────────────────
    let int seq_a = 5
    mut [float32] audio_like = []
    for i in 0..<(seq_a * d):
        audio_like.push((i as float32) * 0.015 - 0.35)

    let [float32] mha_cross_gpu_v = mha_gpu(xq, audio_like, wq, bq, wk, zeros(d), wv, bv2, wo, bo, seq_q, seq_a, d, n_head, false)
    let [float32]'kernel'unified cross_k = linear_nobias_gpu(audio_like, wk, seq_a, d, d)
    let [float32]'kernel'unified cross_v = linear_gpu(audio_like, wv, bv2, seq_a, d, d)
    var float32 cross_step_diff = 0.0
    for i in 0..<seq_q:
        let [float32] x_i = xq[(i * d)..<((i + 1) * d)]
        let [float32] out_i = mha_cross_step_gpu(x_i, wq, bq, cross_k, cross_v, wo, bo, seq_a, d, n_head)
        for j in 0..<d:
            let expected = mha_cross_gpu_v[i * d + j]
            let dd = if expected > out_i[j]: expected - out_i[j] else: out_i[j] - expected
            if dd > cross_step_diff: cross_step_diff = dd
    print "mha_cross_step_gpu (vs non-causal mha_gpu, per-position): max diff = {cross_step_diff:.8f}  (expect ~0)"

    # ── conv1d ────────────────────────────────────────────────────────────
    let int t_in  = 6
    let int c_in  = 2
    let int c_out = 3
    let int kk    = 3
    mut [float32] cx = []
    for i in 0..<(t_in * c_in):
        cx.push((i as float32) * 0.05 - 0.15)
    mut [float32] cw = []
    for i in 0..<(c_out * c_in * kk):
        cw.push((i as float32) * 0.02 - 0.1)
    mut [float32] cb = []
    for i in 0..<c_out:
        cb.push((i as float32) * 0.01)

    let [float32] conv_cpu = conv1d(cx, cw, cb, t_in, c_in, c_out, kk)
    let [float32] conv_gpu = conv1d_gpu(cx, cw, cb, t_in, c_in, c_out, kk, 1, t_in)
    var float32 conv_diff = 0.0
    for i in 0..<conv_cpu.length:
        let d = if conv_cpu[i] > conv_gpu[i]: conv_cpu[i] - conv_gpu[i] else: conv_gpu[i] - conv_cpu[i]
        if d > conv_diff: conv_diff = d
    print "conv1d (stride 1): max |cpu-gpu| = {conv_diff:.8f}  (expect ~0)"

    # ── conv1d stride 2 (encoder's conv2 pattern) ─────────────────────────
    let int t_out2 = t_in / 2
    mut [float32] conv2_cpu = []
    for i in 0..<t_out2:
        let int src = i * 2
        for oc in 0..<c_out:
            var float32 s = cb[oc]
            let int pad2 = kk / 2
            for ic in 0..<c_in:
                for ki in 0..<kk:
                    let int si = src + ki - pad2
                    if si >= 0 and si < t_in:
                        s += cx[si * c_in + ic] * cw[oc * c_in * kk + ic * kk + ki]
            conv2_cpu.push(s)
    let [float32] conv2_gpu = conv1d_gpu(cx, cw, cb, t_in, c_in, c_out, kk, 2, t_out2)
    var float32 conv2_diff = 0.0
    for i in 0..<conv2_cpu.length:
        let d = if conv2_cpu[i] > conv2_gpu[i]: conv2_cpu[i] - conv2_gpu[i] else: conv2_gpu[i] - conv2_cpu[i]
        if d > conv2_diff: conv2_diff = d
    print "conv1d (stride 2): max |cpu-gpu| = {conv2_diff:.8f}  (expect ~0)"

    # ── argmax_gpu (greedy decode reduction across 51865 logits) ──────────
    let int n_logits = 51865
    mut [float32] logits_test = [0.0 as float32 for ..<n_logits]
    logits_test[31415] = 42.5 as float32
    logits_test[100] = 10.0 as float32
    let int best_idx = argmax_gpu(logits_test, n_logits)
    print "argmax_gpu: expected 31415, got {best_idx}"
    guard best_idx == 31415 else throw "argmax_gpu failed"

    print "=== GPU math test passed ==="
